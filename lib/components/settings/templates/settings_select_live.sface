<div class={"h-full": @stacked}>
  <div
    :if={@label}
    class="badge mb-2 !border !border-warning/30 badge-outline badge-warning badge-sm"
  >{@label}</div>
  <div class={
    "flex flex-col gap-4 justify-between",
    "lg:flex-row lg:items-center": !@stacked,
    "h-full": @stacked
  }>
    <div class="flex flex-col flex-1 gap-0.5">
      <div class="text-sm font-medium text-base-content" :if={@name}>{@name}</div>
      <div class="text-sm text-muted" :if={@description}>{@description}</div>
    </div>

    <label for={@id} class="sr-only">{@label_name}</label>
    <input name="scope" value={@scope} type="hidden">
    <select
      id={@id}
      class={
        "select select-bordered",
        "select-sm max-w-xs": !@stacked,
        "w-full max-w-none min-h-11 text-base rounded-box": @stacked
      }
      name={@input}
    >
      {#for {key, val} <- @options || []}
        {#if to_string(key) == ""}
          {!-- an option that picks no value: Surface drops an attribute whose value is "", and an option with no value sends its text, so its empty value is written out literally --}
          <option value="" selected={if to_string(@current_value) == "", do: "selected"}>
            {val}
          </option>
        {#else}
          <option
            value={to_string(key)}
            selected={if @current_value == key or to_string(@current_value) == to_string(key), do: "selected"}
          >
            {val}
          </option>
        {/if}
      {/for}
      {#for val when is_binary(val) or is_atom(val) <- @options || []}
        <option
          value={to_string(val)}
          selected={if @current_value == val or to_string(@current_value) == to_string(val), do: "selected"}
        >
          {val}
        </option>
      {#else}
        <option value={nil}>{l("No options available")}</option>
      {/for}
    </select>
  </div>
</div>

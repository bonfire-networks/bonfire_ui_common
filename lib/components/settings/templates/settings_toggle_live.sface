<div>
  <input name="scope" value={@scope} type="hidden">
  <input name={@input} value={to_string(@disabled_value)} type="hidden">

  <label for={@id} class={"flex items-center", "justify-between": !@compact}>
    <div class={"flex flex-col gap-0.5 mr-2", "order-last ml-4 !mr-0": @compact}>
      <div class="flex flex-row items-center gap-2" :if={@name}>
        <div class="text-sm font-medium text-base-content">{@name}</div>
        {!-- the description as a tooltip to hover, and the same words for a screen reader, which a tooltip alone doesn't reach --}
        <span
          :if={@description && @description_tooltip}
          class="tooltip tooltip-right inline-flex cursor-help text-subtle"
          data-tip={@description}
          aria-describedby={"#{@id}-description"}
          tabindex="0"
        >
          <#Icon iconify="ph:info" class="size-4" aria-hidden="true" />
        </span>
        <div
          :if={@show_label}
          class="badge !border !border-warning/30 badge-outline badge-warning badge-sm"
        >{@label}</div>
      </div>
      <span :if={@description && @description_tooltip} id={"#{@id}-description"} class="sr-only">{@description}</span>
      <div class="text-sm text-muted" :if={@description && !@description_tooltip}>{@description}</div>
    </div>

    <input
      id={@id}
      name={@input}
      value={to_string(@enabled_value)}
      type="checkbox"
      checked={if @current_value == @enabled_value,
        do: "checked"}
      class="toggle toggle-sm toggle-primary"
    />
  </label>
</div>
<select
  id="change_locale"
  name="Elixir.Bonfire.Common.Localise.Cldr[default_locale]"
  class="w-full max-w-xs select select-bordered"
  :hook
  data-scope={@scope}
>
  {#for {l, name} <- Localise.known_locales_names_localised()}
    <option
      class=""
      value={to_string(l)}
      selected={if to_string(@locale) == to_string(l), do: "selected"}
    >
      {!-- the name is wrapped in Unicode isolate marks (U+2068 … U+2069): an option can only hold text, and takes its direction from its first strong letter, so a right-to-left name would reverse the share after it --}
      {<<0x2068::utf8>> <> name <> <<0x2069::utf8>>}{#case Coverage.translated_label(l)}
        {#match nil}
        {#match label}
          · {label}
      {/case}
    </option>
  {#else}
    <option>No localisation available</option>
  {/for}
</select>

<div class="w-full mt-4 form-control">
  <div class="mb-3 text-sm font-medium text-muted">{l("Theme mode")}</div>
  <div class="grid grid-cols-2 gap-2">
    {!-- FOLLOW INSTANCE (the default: no choice of this scope's own, so the instance's
         theme — light, dark, system or custom — cascades through) --}
    <button
      :if={@show_follow_option}
      id={"#{@id_prefix}-follow-button"}
      type="button"
      class={"btn flex-1 justify-between gap-2 min-h-12 col-span-2 #{if @selected == :instance_default, do: "btn-primary"}"}
      phx-click={JS.push("Bonfire.Common.Settings:reset_theme", value: %{scope: @scope})
      |> JS.add_class("btn-primary", to: "##{@id_prefix}-follow-button")
      |> JS.remove_class("btn-primary", to: "##{@id_prefix}-dark-button")
      |> JS.remove_class("btn-primary", to: "##{@id_prefix}-light-button")
      |> JS.remove_class("btn-primary", to: "##{@id_prefix}-system-button")
      |> JS.remove_class("btn-primary", to: "##{@id_prefix}-custom-button")
      |> JS.hide(to: "##{@id_prefix}-dark-themes")
      |> JS.hide(to: "##{@id_prefix}-light-themes")
      |> JS.hide(to: "##{@id_prefix}-custom-themes")}
    >
      <span class="flex items-center gap-2">
        <#Icon iconify="ph:buildings" class="w-4 h-4" />
        <span>{l("Follow instance theme")}</span>
      </span>
      <span :if={@selected == :instance_default} class="badge badge-sm">{l("Active")}</span>
    </button>

    {!-- DARK --}
    <button
      id={"#{@id_prefix}-dark-button"}
      class={"btn flex-1 justify-between gap-2 min-h-12 #{if @selected in [:dark], do: "btn-primary"}"}
      phx-click={JS.push("Bonfire.Common.Settings:put_theme",
        value: %{keys: "ui:theme:preferred", values: :dark, scope: @scope}
      )
      |> JS.add_class("btn-primary", to: "##{@id_prefix}-dark-button")
      |> JS.remove_class("btn-primary", to: "##{@id_prefix}-follow-button")
      |> JS.remove_class("btn-primary", to: "##{@id_prefix}-light-button")
      |> JS.remove_class("btn-primary", to: "##{@id_prefix}-system-button")
      |> JS.remove_class("btn-primary", to: "##{@id_prefix}-custom-button")
      |> JS.show(to: "##{@id_prefix}-dark-themes")
      |> JS.hide(to: "##{@id_prefix}-light-themes")
      |> JS.hide(to: "##{@id_prefix}-custom-themes")}
    >
      <span class="flex items-center gap-2">
        <#Icon iconify="ph:moon" class="w-4 h-4" />
        <span>{l("Use dark")}</span>
      </span>
      <span :if={@selected == :dark} class="badge badge-sm">{l("Active")}</span>
    </button>

    <button
      id={"#{@id_prefix}-light-button"}
      class={"btn flex-1 justify-between gap-2 min-h-12 #{if @selected in [:light], do: "btn-primary"}"}
      phx-click={JS.push("Bonfire.Common.Settings:put_theme",
        value: %{keys: "ui:theme:preferred", values: :light, scope: @scope}
      )
      |> JS.remove_class("btn-primary", to: "##{@id_prefix}-follow-button")
      |> JS.remove_class("btn-primary", to: "##{@id_prefix}-dark-button")
      |> JS.add_class("btn-primary", to: "##{@id_prefix}-light-button")
      |> JS.remove_class("btn-primary", to: "##{@id_prefix}-system-button")
      |> JS.remove_class("btn-primary", to: "##{@id_prefix}-custom-button")
      |> JS.hide(to: "##{@id_prefix}-dark-themes")
      |> JS.show(to: "##{@id_prefix}-light-themes")
      |> JS.hide(to: "##{@id_prefix}-custom-themes")}
    >
      <span class="flex items-center gap-2">
        <#Icon iconify="ph:sun" class="w-4 h-4" />
        <span>{l("Use light")}</span>
      </span>
      <span :if={@selected == :light} class="badge badge-sm">{l("Active")}</span>
    </button>

    <button
      id={"#{@id_prefix}-system-button"}
      class={"btn flex-1 justify-between gap-2 min-h-12 #{if @selected in [:system], do: "btn-primary"}"}
      phx-click={JS.push("Bonfire.Common.Settings:put_theme",
        value: %{keys: "ui:theme:preferred", values: :system, scope: @scope}
      )
      |> JS.add_class("btn-primary", to: "##{@id_prefix}-system-button")
      |> JS.remove_class("btn-primary", to: "##{@id_prefix}-follow-button")
      |> JS.remove_class("btn-primary", to: "##{@id_prefix}-dark-button")
      |> JS.remove_class("btn-primary", to: "##{@id_prefix}-light-button")
      |> JS.remove_class("btn-primary", to: "##{@id_prefix}-custom-button")
      |> JS.show(to: "##{@id_prefix}-dark-themes")
      |> JS.show(to: "##{@id_prefix}-light-themes")
      |> JS.hide(to: "##{@id_prefix}-custom-themes")}
    >
      <span class="flex items-center gap-2">
        <#Icon iconify="ph:desktop" class="w-4 h-4" />
        <span>{l("Use system")}</span>
      </span>
      <span :if={@selected == :system} class="badge badge-sm">{l("Active")}</span>
    </button>

    <button
      phx-click={JS.push("Bonfire.Common.Settings:put_theme",
        value: %{keys: "ui:theme:preferred", values: :custom, scope: @scope}
      )
      |> JS.remove_class("btn-primary", to: "##{@id_prefix}-follow-button")
      |> JS.remove_class("btn-primary", to: "##{@id_prefix}-dark-button")
      |> JS.remove_class("btn-primary", to: "##{@id_prefix}-light-button")
      |> JS.remove_class("btn-primary", to: "##{@id_prefix}-system-button")
      |> JS.add_class("btn-primary", to: "##{@id_prefix}-custom-button")
      |> JS.hide(to: "##{@id_prefix}-dark-themes")
      |> JS.hide(to: "##{@id_prefix}-light-themes")
      |> JS.show(to: "##{@id_prefix}-custom-themes")}
      id={"#{@id_prefix}-custom-button"}
      type="button"
      class={"btn flex-1 justify-between gap-2 min-h-12 #{if @selected == :custom, do: "btn-primary"}"}
    >
      <span class="flex items-center gap-2">
        <#Icon iconify="ph:paint-brush-fill" class="w-4 h-4" />
        <span>{l("Use custom")}</span>
      </span>
      <span :if={@selected == :custom} class="badge badge-sm">{l("Active")}</span>
    </button>
  </div>

  <div>
    <div id={"#{@id_prefix}-dark-themes"} class={if @selected not in [:dark, :system], do: "hidden"}>
      <div class="shadow rounded-md border bg-base-200 border-secondary p-4 mt-4">
        <div class="mb-1 text-sm font-medium text-muted">{l("Dark mode theme")}</div>
        <div class="mb-4 text-xs text-base-content/60">
          {l("Used when theme mode is Dark, or when System switches to dark.")}
        </div>
        <Bonfire.UI.Common.ChangeThemeLive
          key="instance_theme"
          theme={@theme}
          themes={@themes}
          action_label={l("Choose")}
          scope={@scope}
        />
      </div>
    </div>
    <div
      id={"#{@id_prefix}-light-themes"}
      class={if @selected not in [:light, :system], do: "hidden"}
    >
      <div class="shadow rounded-md border bg-base-200 border-secondary p-4 mt-4">
        <div class="mb-1 text-sm font-medium text-muted">{l("Light mode theme")}</div>
        <div class="mb-4 text-xs text-base-content/60">
          {l("Used when theme mode is Light, or when System switches to light.")}
        </div>
        <Bonfire.UI.Common.ChangeThemeLive
          key="instance_theme_light"
          theme={@theme_light}
          themes={@themes_light}
          action_label={l("Choose")}
          scope={@scope}
        />
      </div>
    </div>
  </div>

  <div
    id={"#{@id_prefix}-custom-themes"}
    class={"shadow rounded-md border bg-base-200 border-secondary p-4 mt-4 #{if @selected != :custom, do: "hidden"}"}
    data-scope={@scope}
    data-theme={@theme}
    style={@theme_style}
  >
    <div class="mb-4 flex items-center justify-between gap-2">
      <div class="flex items-center gap-2">
        <#Icon iconify="ph:paint-brush-fill" class="w-5 h-5 text-primary" />
        <span class="text-base font-bold">{l("Custom theme")}</span>
        <span :if={@selected == :custom} class="badge badge-primary badge-sm">{l("Active now")}</span>
      </div>
      {!-- only offer a reset once there's at least one override to clear --}
      <button
        :if={map_size(@custom_tokens) > 0}
        type="button"
        data-role="reset_custom_theme"
        class="btn btn-sm btn-ghost text-error gap-1"
        data-confirm={l("Remove all saved custom theme overrides? This cannot be undone.")}
        phx-click={JS.push("Bonfire.Common.Settings:reset_custom_theme", value: %{scope: @scope})}
      >
        <#Icon iconify="ph:arrow-counter-clockwise" class="w-4 h-4" />
        {l("Reset all")}
      </button>
    </div>

    <div :if={@show_accessibility_caution}>
      <div class="alert alert-info shadow-sm mb-6" role="alert">
        <#Icon iconify="ph:info-fill" class="w-5 h-5 shrink-0" />
        <span>
          {l(
            "Caution: Modifying the color palette can affect readability and accessibility. Consider accessibility guidelines when making changes."
          )}
        </span>
      </div>
    </div>

    <div class="space-y-6">
      {!-- Colors Section --}
      <section>
        <h3 class="divider divider-start text-sm mt-6">
          <span class="flex items-center gap-1.5">
            <svg
              class="opacity-60 w-5 h-5"
              viewBox="0 0 48 48"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
            >
              <path
                fill-rule="evenodd"
                clip-rule="evenodd"
                d="M37 37C39.2091 37 41 35.2091 41 33C41 31.5272 39.6667 29.5272 37 27C34.3333 29.5272 33 31.5272 33 33C33 35.2091 34.7909 37 37 37Z"
                fill="currentColor"
              />
              <path
                d="M20.8535 5.50439L24.389 9.03993"
                stroke="currentColor"
                stroke-width="4"
                stroke-linecap="round"
              />
              <path
                d="M23.6818 8.33281L8.12549 23.8892L19.4392 35.2029L34.9955 19.6465L23.6818 8.33281Z"
                stroke="currentColor"
                stroke-width="4"
                stroke-linejoin="round"
              />
              <path
                d="M12 20.0732L28.961 25.6496"
                stroke="currentColor"
                stroke-width="4"
                stroke-linecap="round"
              />
            </svg>
            <span class="font-medium">{l("Colors")}</span>
          </span>
        </h3>

        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 pt-2">
          {#for group <- @color_groups}
            <div class={Map.get(group, :wrapper_class, "col-span-2")}>
              <h4 class="text-xs font-medium text-muted mb-2">{group.label}</h4>
              <div class={"grid gap-2", Map.get(group, :grid_class, "grid-cols-2")}>
                {#for color <- group.colors}
                  <Bonfire.UI.Common.CustomThemeColourLive
                    color={color}
                    custom_tokens={@custom_tokens}
                    id_prefix={@id_prefix}
                    scope={@scope}
                    base_theme={@theme}
                    theme_style={@theme_style}
                  />
                {/for}
              </div>
            </div>
          {/for}
        </div>
      </section>

      {!-- Radius Section --}
      <section>
        <h3 class="divider divider-start text-sm mt-6">
          <span class="flex items-center gap-1.5">
            <svg
              class="opacity-60 w-5 h-5"
              viewBox="0 0 48 48"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
            >
              <path
                d="M24 42V27M42 24H27"
                stroke="currentColor"
                stroke-width="4"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
              <circle
                cx="24"
                cy="24"
                r="3"
                stroke="currentColor"
                stroke-width="4"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
              <path
                d="M42 6H24C14.0589 6 6 14.0589 6 24V42"
                stroke="currentColor"
                stroke-width="4"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
            <span class="font-medium">{l("Radius")}</span>
          </span>
        </h3>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-3 pt-2">
          {#for group <- @radius_groups}
            <div class="border border-secondary p-3 bg-base-100 rounded">
              <div class="mb-2 flex flex-col" id={"#{@id_prefix}-#{group.token}-group"}>
                <span class="text-muted text-sm font-medium">{group.label}</span>
                <span class="text-muted text-xs italic">{group.description}</span>
              </div>
              <div
                class="flex flex-wrap gap-2"
                role="radiogroup"
                aria-labelledby={"#{@id_prefix}-#{group.token}-group"}
              >
                {#for radius <- [nil, "0rem", "0.5rem", "1rem", "2rem"]}
                  <label
                    class={
                      "flex-1 min-h-11 rounded-lg bg-base-200 hover:bg-base-300 focus-within:outline-base-content relative cursor-pointer overflow-hidden transition-colors focus-within:outline-2 focus-within:outline-offset-2 p-1",
                      "bg-primary/10": radius_selected?(@custom_tokens, group.token, radius)
                    }
                    title={radius || l("Inherited")}
                  >
                    <input
                      id={"#{@id_prefix}-#{group.token}-#{String.replace(radius || "inherited", ".", "_")}"}
                      type="radio"
                      class="sr-only"
                      name={"#{@id_prefix}-#{group.token}"}
                      value={radius || "inherited"}
                      aria-label={
                        if(is_nil(radius),
                          do: l("Inherit %{group} radius", group: group.label),
                          else: l("%{radius} %{group} radius", radius: radius, group: group.label)
                        )
                      }
                      checked={radius_selected?(@custom_tokens, group.token, radius)}
                      phx-click={
                        if(is_nil(radius),
                          do:
                            JS.push("Bonfire.Common.Settings:reset_custom_theme_token",
                              value: %{token: group.token, scope: @scope}
                            ),
                          else:
                            JS.push("Bonfire.Common.Settings:put_custom_theme_token",
                              value: %{token: group.token, value: radius, scope: @scope}
                            )
                        )
                      }
                    />
                    <div class="flex flex-col items-center justify-center gap-1 py-1" aria-hidden="true">
                      <div
                        class={
                          "h-5 w-7 border-e-2 border-t-2 bg-base-300",
                          "border-primary": radius_selected?(@custom_tokens, group.token, radius),
                          "border-secondary": !radius_selected?(@custom_tokens, group.token, radius)
                        }
                        style={"border-start-end-radius:#{radius || "var(--#{group.token})"}"}
                      />
                      <span class="text-[10px] leading-none">{radius || l("Base")}</span>
                    </div>
                  </label>
                {/for}
              </div>
            </div>
          {/for}
        </div>
      </section>
    </div>
  </div>
</div>

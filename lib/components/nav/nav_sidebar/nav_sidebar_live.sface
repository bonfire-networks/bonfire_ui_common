{#if current_user_id(@__context__)}
  <div class="flex flex-col flex-1 h-full px-card">
    <Bonfire.UI.Common.ExtensionMenuNavLive
      parent_id="nav_sidebar"
      selected_tab={@selected_tab}
      page={@page}
      nav_items={@nav_items}
    />
    <Bonfire.UI.Common.SidebarWidgetsLive
      widgets={@sidebar_widgets}
      key={:main}
      page={@page}
      selected_tab={@selected_tab}
    />
  </div>
{#else}
  {#case to_string(Bonfire.Common.Settings.get([:ui, :sidebar, :section_divider], "none", :instance))}
    {#match "line"}
      <div
        class="my-1 px-4 lg:px-7.5"
        style="border-top: 1px solid color-mix(in oklch, var(--color-base-content) 10%, transparent)"
        aria-hidden="true"
      />
    {#match "custom"}
      {#case to_string(Bonfire.Common.Settings.get([:ui, :sidebar, :section_divider_image], "", :instance))}
        {#match src when src != ""}
          <div class="px-10 flex justify-center px-4 lg:px-7.5" aria-hidden="true">
            <img src={src} class="h-6 w-full object-contain mt-4" alt="">
          </div>
        {#match _}
      {/case}
    {#match _}
  {/case}
  {!-- mirrors Bonfire.UI.Common.LinkWidgetLive so guest links match the signed-in nav --}
  <nav class="mt-4 px-2 lg:px-5.5">
    <ul class="menu p-0 w-full gap-0">
      <li :for={link <- guest_links(@__context__, @page)} class="p-0 m-0">
        <LinkLive
          to={link.to}
          class={[
            "nav-row transition-colors duration-150",
            Bonfire.UI.Common.LinkWidgetLive.active_link_class(link.active?)
          ]}
          opts={if link.active?, do: ["aria-current": "page"], else: []}
          parent_id="nav_sidebar"
        >
          <Iconify.iconify
            icon={link.icon}
            class={["size-5", Bonfire.UI.Common.LinkWidgetLive.active_icon_class(link.active?)]}
          />
          <div class={["nav-label", Bonfire.UI.Common.LinkWidgetLive.active_label_class(link.active?)]}>{link.label}</div>
        </LinkLive>
      </li>
    </ul>
  </nav>
{/if}

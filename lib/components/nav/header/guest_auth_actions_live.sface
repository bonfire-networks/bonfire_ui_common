{#if current_account_id(@__context__)}
  <LinkLive to={path(:switch_user) || "/switch-user/"} class={@login_class} opts={[id: @login_id]}>{l("Choose a profile")}</LinkLive>
{#elseif !Bonfire.Me.Accounts.instance_is_invite_only?()}
  {!-- on the log in page the form's button is the main action, so Sign up drops to the quieter style --}
  <LinkLive :if={@current != :login} to={path(:login, :index)} class={@login_class} opts={[id: @login_id]}>{l("Log in")}</LinkLive>
  <LinkLive
    :if={@current != :signup}
    to={path(:signup)}
    class={if @current == :login, do: @login_class, else: @signup_class}
    opts={[id: @signup_id]}
  >{l("Sign up")}</LinkLive>
{#elseif @current != :login}
  <LinkLive to={path(:login, :index)} class={@login_class} opts={[id: @login_id]}>{l("Sign in")}</LinkLive>
{/if}

<div
  id={@id}
  class={
    "motion-modal",
    @modal_class,
    "modal modal-bottom sm:modal-middle max-h-[100%] z-modal": !@no_backdrop,
    "fixed left-0 z-modal bottom-0 transition-opacity duration-150 ease": @no_backdrop,
    "motion-instant": @close_motion == :instant,
    "motion-closing": !@show and not is_nil(@close_token),
    "opacity-0 scale-100 modal-closed": !@show,
    "opacity-100 scale-100 translate-y-0 modal-open": @show
  }
  aria-hidden={if !@show, do: "true"}
  inert={!@show}
  phx-window-keydown={if @show, do: "close-key"}
  phx-key="escape"
  phx-target={"[id='#{@id}']"}
  {...@opts}
>
  <div
    :if={!@no_backdrop}
    phx-click="close"
    phx-target={"[id='#{@id}']"}
    class="fixed inset-0 -z-1"
    aria-hidden="true"
  >
  </div>
  {!-- if the modal should be wrapped in a form use the form tag, otherwise use a div --}
  <Phoenix.Component.dynamic_tag
    tag_name={if @form_opts != %{}, do: "form", else: "div"}
    id={@form_opts[:id] || "#{@id}_box"}
    role="dialog"
    aria-modal="true"
    aria-labelledby={if !@no_header, do: "#{@id}_title"}
    aria-label={if @no_header, do: @title_text}
    class={Surface.css_class([
      "text-base-content relative",
      "w-full h-full": @image_preview,
      "modal-box !p-0 flex flex-col overflow-hidden max-h-[85dvh]":
        !@image_preview and !@overflow and !@no_backdrop,
      "modal-box p-4": @overflow or (@no_backdrop and !@image_preview),
      "overflow-y-visible": @overflow,
      "h-full": @no_backdrop
    ])}
    {...Enums.naughty_to_atoms!(@form_opts)}
  >
    {!-- Mount `focus_wrap` at open time so its hook moves keyboard focus into the
         dialog. Keep it mounted and inert for the short closing transition so the
         modal box preserves its dimensions until the exit completes. Its sentinels
         keep Tab cycling within the dialog while open (WCAG 2.1.2 / 2.4.3), and
         `class="contents"` keeps the box's flex-column layout unaffected. --}
    {#if @show or @close_token}
      <Phoenix.Component.focus_wrap id={"#{@id}_focus_wrap"} class="contents">
        {!-- Close button (always anchored to modal-box top-right, never scrolls) --}
        <div class={
          "absolute block",
          "top-2 right-2 z-popover": !@no_backdrop and (!@overflow or @image_preview),
          "-top-3 -right-3 z-popover": !@no_backdrop and @overflow and !@image_preview,
          "top-1 -right-3 z-tooltip h-full": @no_backdrop
        }>
          <div class={Surface.css_class("pt-safe": @image_preview or @no_backdrop)}>
            <button
              phx-click="close"
              phx-target={"[id='#{@id}']"}
              type="button"
              aria-label={l("Close modal")}
              class={
                "btn btn-circle btn-sm focus-ring transition-interactive sm-only:touch-target",
                "btn-ghost": !@image_preview,
                "btn-primary": @image_preview,
                "!rounded-none btn-ghost !btn-xs opacity-70 btn-secondary": @no_backdrop
              }
            >
              <span class="sr-only">{l("Close")}</span>
              <#Icon iconify="ph:x" class="w-5 h-5" aria-hidden="true" />
            </button>
          </div>
        </div>

        {#if @image_preview or @overflow or @no_backdrop}
          {!-- Legacy single-scroll layout — needed for:
           • image_preview: full-bleed image viewer
           • @overflow: dropdowns/popovers that must escape the modal box
           • @no_backdrop: sidebar / sticky-mode layout --}
          <div class={"relative z-popover", @wrapper_class}>
            <h3
              :if={!@no_header}
              id={"#{@id}_title"}
              class={@title_class || "font-bold text-base line-clamp-1 px-2 max-w-full"}
            >
              <#slot {@title}>{@title_text}</#slot>
            </h3>

            <div
              class={
                "h-full",
                "max-h-[calc(100dvh_-_13rem)]": !@image_preview,
                "h-[95%]": @no_backdrop
              }
              data-id="modal-contents"
            >
              <#slot {@default, autocomplete: @autocomplete, value: @value}>
                {!-- TODO: consolidate with PreviewContent and make modal_component & modal_view seperate props --}
                {#if e(@modal_assigns, :modal_component_stateful?, nil) == true and
                    module_enabled?(@modal_assigns[:modal_component], @__context__)}
                  <StatefulComponent
                    id="modal_component"
                    module={@modal_assigns[:modal_component]}
                    {...@modal_assigns}
                  />
                {#elseif not is_nil(e(@modal_assigns, :modal_component, nil)) and
                    module_enabled?(@modal_assigns[:modal_component], @__context__)}
                  <StatelessComponent
                    module={@modal_assigns[:modal_component]}
                    myself={@myself}
                    {...@modal_assigns}
                  />
                {#elseif not is_nil(e(@modal_assigns, :modal_view, nil)) and
                    module_enabled?(@modal_assigns[:modal_view], @__context__)}
                  {live_render(@socket, @modal_assigns[:modal_view],
                    id: "modal_view",
                    session: %{"params" => @modal_assigns}
                  )}
                {#else}
                  {!-- empty --}
                {/if}
              </#slot>
            </div>

            <div :if={!@no_actions} class="modal-action">
              <div phx-click="close" phx-target={"[id='#{@id}']"}>
                <#slot {@cancel_btn}>
                </#slot>
              </div>
              <div class={@action_btns_wrapper_class}>
                <#slot {@action_btns}>
                  <button :if={@form_opts != %{}} class="normal-case btn btn-primary btn-sm" type="submit">{l("OK")}</button>
                </#slot>
              </div>
            </div>
          </div>
        {#else}
          {!-- Default layout: sticky header, scrollable middle, sticky footer --}
          <header :if={!@no_header} class="shrink-0 pl-4 pt-4 pb-3 pr-14 border-b-hair border-secondary">
            <h3 id={"#{@id}_title"} class={@title_class || "font-bold text-base line-clamp-1 max-w-full"}>
              <#slot {@title}>{@title_text}</#slot>
            </h3>
          </header>

          <div
            class={
              "relative z-popover flex-1 min-h-0 overflow-y-auto overscroll-contain px-4 pt-4",
              @wrapper_class,
              "pb-safe-offset-4": @no_actions,
              "pb-4": !@no_actions
            }
            data-id="modal-contents"
          >
            <#slot {@default, autocomplete: @autocomplete, value: @value}>
              {!-- TODO: consolidate with PreviewContent and make modal_component & modal_view seperate props --}
              {#if e(@modal_assigns, :modal_component_stateful?, nil) == true and
                  module_enabled?(@modal_assigns[:modal_component], @__context__)}
                <StatefulComponent
                  id="modal_component"
                  module={@modal_assigns[:modal_component]}
                  {...@modal_assigns}
                />
              {#elseif not is_nil(e(@modal_assigns, :modal_component, nil)) and
                  module_enabled?(@modal_assigns[:modal_component], @__context__)}
                <StatelessComponent
                  module={@modal_assigns[:modal_component]}
                  myself={@myself}
                  {...@modal_assigns}
                />
              {#elseif not is_nil(e(@modal_assigns, :modal_view, nil)) and
                  module_enabled?(@modal_assigns[:modal_view], @__context__)}
                {live_render(@socket, @modal_assigns[:modal_view],
                  id: "modal_view",
                  session: %{"params" => @modal_assigns}
                )}
              {#else}
                {!-- empty --}
              {/if}
            </#slot>
          </div>

          <div
            :if={!@no_actions}
            class={
              "shrink-0 modal-action px-4 pb-safe-offset-4 pt-3 border-t-hair border-secondary",
              @action_btns_wrapper_class
            }
          >
            <div phx-click="close" phx-target={"[id='#{@id}']"}>
              <#slot {@cancel_btn}>
              </#slot>
            </div>
            <div>
              <#slot {@action_btns}>
                <button :if={@form_opts != %{}} class="normal-case btn btn-primary btn-sm" type="submit">{l("OK")}</button>
              </#slot>
            </div>
          </div>
        {/if}
      </Phoenix.Component.focus_wrap>
    {/if}
  </Phoenix.Component.dynamic_tag>
</div>

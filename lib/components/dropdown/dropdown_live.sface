<div
  id={@id}
  phx-hook="Tooltip"
  data-position={@position}
  data-trigger={@open_on}
  data-strategy={@strategy}
  data-match-trigger-width={if @match_trigger_width, do: "true"}
  data-focus-on-open={@focus_on_open}
  data-no-flip={if @no_flip, do: "true"}
  data-close-on-inside-click={if @close_on_select, do: "true"}
  aria-haspopup="true"
  class={"relative", @wrapper_class}
  {...@wrapper_opts}
>
  <button
    type="button"
    tabindex="0"
    id={@id <> "_trigger"}
    class={"tooltip-button", @trigger_class, "touch-target-expanded": @expanded_touch_target}
    aria-haspopup="true"
    aria-expanded="false"
    aria-controls={@id <> "_panel"}
    aria-label={@label}
    {...@trigger_opts}
  >
    <span :if={@expanded_touch_target} class="touch-target-hit-area" aria-hidden="true" />
    <#slot {@trigger} />
  </button>

  {#if @menu}
    <ul
      tabindex="0"
      id={@id <> "_panel"}
      class={"tooltip menu dropdown-panel", @panel_class}
      role="menu"
      aria-orientation="vertical"
      aria-labelledby={@id <> "_trigger"}
    >
      <#slot />
    </ul>
  {#else}
    <div
      tabindex="0"
      id={@id <> "_panel"}
      class={"tooltip dropdown-panel", @panel_class}
      aria-labelledby={@id <> "_trigger"}
    >
      <#slot />
    </div>
  {/if}
</div>

<div
  id={deterministic_dom_id(__MODULE__, nil, "expandable_note", @parent_id)}
  data-ref={deterministic_dom_id(__MODULE__, nil, "note_ref", @parent_id)}
  data-id="object_body"
  data-role="html_body"
  data-truncatable
  data-inception={@activity_inception}
  data-rendered={@showing_within}
  data-main-object={@viewing_main_object}
  class={
    "object_body prose-bonfire translatable prose break-normal max-w-none text-base-content prose-hr:!my-2 prose-br:hidden prose-a:font-normal",
    previewable_truncate:
      !@viewing_main_object &&
        @showing_within not in [:smart_input, :pinned],
    # microblog posts read as one block: paragraph breaks cost ~half a line, not article-style margins
    "prose-p:!my-1": e(@object_type, nil) != :article,
    # Give the main note modest emphasis while preserving article typography.
    "!text-lg !leading-[1.5]":
      @viewing_main_object && @showing_within == :thread && e(@object_type, nil) != :article,
    "!text-sm !text-muted": e(@object_type, nil) == :article && @showing_within != :thread
  }
>
  <Bonfire.UI.Common.HtmlBodyPartsLive
    html_body={@html_body}
    rich_opts={rich_opts(@is_remote)}
    inline_media={@inline_media}
    body_parts={@body_parts}
    cw={@cw}
    is_remote={@is_remote}
    parent_id={@parent_id}
    showing_within={@showing_within}
    viewing_main_object={@viewing_main_object}
    activity_inception={@activity_inception}
  />
</div>

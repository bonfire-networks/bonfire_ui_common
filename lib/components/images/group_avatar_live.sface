{#case Bonfire.UI.Common.NavTileLive.uploaded_avatar_url(@object)}
  {#match nil}
    {#if slot_assigned?(:default)}
      <#slot />
    {#else}
      <Bonfire.UI.Common.NavTileLive object={@object} name={@name} class={@tile_class} />
    {/if}
  {#match url}
    <img
      src={url}
      alt=""
      width={@size}
      height={@size}
      class={@image_class}
      loading={if @lazy, do: "lazy"}
      data-sensitive={not is_nil(@sensitive_id)}
    />
    <span
      :if={@sensitive_id}
      id={@sensitive_id}
      class="absolute inset-0 backdrop-blur-sm bg-black/50 z-40 cursor-pointer rounded-box"
    />
{/case}

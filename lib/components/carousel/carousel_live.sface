{!-- the grid keeps a flex parent from growing to the track's full scroll width --}
<div class="grid grid-cols-1 overflow-hidden">
  <div
    id={@id}
    class={"carousel-scroll gap-2.5", @class}
    phx-hook="CarouselScroll"
    role="list"
    data-expandable={@expandable}
  >
    {#for item <- @items}
      {!-- one card wide below `sm`, `visible_items` from it up, the next one's edge showing; a lone card full width --}
      <div
        data-carousel-card
        role="listitem"
        class="w-[var(--carousel-item-w)] sm:w-[var(--carousel-item-w-sm)] self-start"
        style={if match?([_], @items),
          do: "--carousel-item-w: 100%; --carousel-item-w-sm: 100%;",
          else:
            "--carousel-item-w: #{card_width(1)}; --carousel-item-w-sm: #{card_width(@visible_items)};"}
      >
        <#slot {@card, item: item} />
        {!-- hidden until `CarouselScroll` marks the card `data-clamped` --}
        <button
          :if={@expandable}
          type="button"
          data-role="carousel_card_expand"
          aria-expanded="false"
          phx-click={JS.toggle_attribute({"data-expanded", ""}, to: {:closest, "[data-carousel-card]"})
          |> JS.toggle_attribute({"aria-expanded", "true", "false"})}
          class="group hidden expand-pill"
        >
          <span class="group-aria-expanded:hidden">{l("Show more")}</span>
          <span class="hidden group-aria-expanded:inline">{l("Show less")}</span>
          <#Icon
            iconify="ph:caret-down-bold"
            class="w-3 h-3 transition-transform group-aria-expanded:rotate-180"
          />
        </button>
      </div>
    {/for}
  </div>
</div>

{!-- where you are in the track; `CarouselScroll` marks the dot of the card in view --}
<div
  :if={match?([_, _ | _], @items)}
  data-role="carousel_dots"
  data-carousel-dots={@id}
  class="mt-3 flex justify-center gap-1.5"
  aria-hidden="true"
>
  <span
    :for={_item <- @items}
    data-role="carousel_dot"
    class="h-1.5 w-1.5 rounded-full bg-divider transition-[width,background-color] duration-200 ease-out data-[on]:w-4 data-[on]:bg-base-content/58"
  />
</div>

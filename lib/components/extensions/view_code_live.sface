<div class="">
  <div class="">
    <Bonfire.UI.Common.CodeStylesLive.code_styles_live />
    <div class="w-full flex flex-col gap-2">
      <div class="text-sm">{markdown(@docs)}</div>
      <div class="w-full">
        <div class="w-full">
          <section :if={@code != nil} id={"line-#{@selected_line}"} class="code ghd-container">
            {if @enable_formatter,
              do:
                raw(
                  Text.code_syntax(@code, @filename,
                    line_numbers: true,
                    highlight_lines:
                      if(@selected_line > 0, do: %{lines: [@selected_line], class: "l-highlighted"})
                  )
                ),
              else: @code}
          </section>
        </div>
      </div>
    </div>
  </div>
</div>

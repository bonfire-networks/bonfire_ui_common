<style>
  .ghd-container, .ghd-text, .ghd-text span, .ghd-text-user, .ghd-text-user span {
  font-family: Menlo, Consolas, monospace;
  font-size: 13px;
  }

  .ghd-container {
  margin-bottom: 50px;
  overflow-x: visible;
  position: relative;
  }

  .highlight {
  position: relative;
  background: transparent !important;
  }

  /* line numbers and the selected function's line are styled by the code theme (see `Bonfire.UI.Common.CodeTheme`), a line linked with `#L<n>` is marked here */
  .ghd-container a.l-line-number {
  text-decoration: none;
  }

  .ghd-container .l-line:target {
  background-color: color-mix(in oklab, var(--color-accent) 30%, transparent);
  }

  /* colours follow the daisy theme */
  .ghd-file {
  border: 1px solid var(--color-base-300);
  border-radius: 3px;
  margin-bottom: 1em;
  background-color: var(--color-base-100);
  }

  .ghd-file-header {
  padding: 10px;
  border-bottom: 0.1rem solid var(--color-base-300);
  cursor: pointer;
  background: var(--color-base-100);
  position: -webkit-sticky;
  position: sticky;
  top: 0px;
  z-index: 1;
  }

  .ghd-file-header .reveal-diff {
  display: none;
  float: right;
  color: color-mix(in oklab, var(--color-base-content) 50%, transparent);
  }

  .ghd-file-header .reveal-diff path {
  fill: currentColor;
  }

  .ghd-file-header.collapsed .reveal-diff {
  display: block;
  }

  .ghd-file-header .collapse-diff {
  display: block;
  float: right;
  color: color-mix(in oklab, var(--color-base-content) 50%, transparent);
  }

  .ghd-file-header .collapse-diff path {
  fill: currentColor;
  }

  .ghd-file-header.collapsed .collapse-diff {
  display: none;
  }

  .ghd-chunk-header .ghd-line-number {
  background-color: var(--color-base-200);
  }

  .ghd-file-status {
  color: color-mix(in oklab, var(--color-base-content) 50%, transparent);
  border: 1px solid currentColor;
  border-radius: 3px;
  padding: 0 3px;
  display: inline-block;
  text-transform: uppercase;
  }

  .ghd-file-status-removed {
  color: var(--color-error);
  }

  .ghd-file-status-added {
  color: var(--color-success);
  }

  .ghd-diff {
  overflow-y: hidden;
  }

  .ghd-diff.hidden{
  display: none;
  }

  .ghd-chunk-header {
  background-color: var(--color-base-200);
  color: color-mix(in oklab, var(--color-base-content) 40%, transparent);
  }

  .ghd-line-number {
  width: 80px;
  background-color: var(--color-base-100);
  display: flex;
  color: color-mix(in oklab, var(--color-base-content) 40%, transparent);
  cursor: pointer;
  }

  /* a line linked with its `#<id>` (the line number is the link) */
  .ghd-line:target .ghd-line-number,
  .ghd-line:target .ghd-text {
  background-color: color-mix(in oklab, var(--color-warning) 25%, transparent);
  }

  .ghd-line-number-link {
  display: flex;
  color: inherit;
  text-decoration: none;
  }

  .ghd-line-number-from {
  padding-left: 10px;
  }

  .ghd-line-number-to {
  padding: 0 10px;
  }

  .ghd-line-type-add {
  background-color: color-mix(in oklab, var(--color-success) 15%, transparent);
  }

  .ghd-line-type-add .ghd-line-number {
  background-color: color-mix(in oklab, var(--color-success) 30%, transparent);
  }

  .ghd-line-type-remove {
  background-color: color-mix(in oklab, var(--color-error) 15%, transparent);
  }

  .ghd-line-type-remove .ghd-line-number {
  background-color: color-mix(in oklab, var(--color-error) 30%, transparent);
  }

  .ghd-line-number div {
  width: 35px;
  }

  /* long lines soft wrap, keeping their indentation */
  .ghd-text-internal,
  .ghd-text-user {
  white-space: pre-wrap;
  overflow-wrap: anywhere;
  }

  .ghd-text-internal {
  padding: 0 90px;
  }

  .ghd-text-user pre {
  display: inline;
  }

  /* code blocks soft wrap via `pre.lumis` in app.css; wrapped rows of a line start after its number, rather than under it */
  .ghd-container .l-line-number {
  display: inline-block;
  width: 4ch;
  margin-right: 1ch;
  text-align: right;
  /* text-indent is inherited, the hanging indent below must not move the number itself */
  text-indent: 0;
  }

  .ghd-container .l-line:has(> .l-line-number) {
  /* Lumis gives each line `width: 100%`, so the indent must fit inside it */
  box-sizing: border-box;
  padding-left: 5ch;
  text-indent: -5ch;
  }
</style>

<div
  :if={@editable}
  class="hidden widgets-editing:block px-1 pb-2 type-caption font-medium text-subtle"
>{l("Sidebar")}</div>
{#case ((not is_nil(current_user_id(@__context__)) and e(@widgets, :users, @key, nil)) ||
     (is_nil(current_user_id(@__context__)) and e(@widgets, :guests, @key, nil)) || [])
  |> Enum.map(fn
    {component, component_assigns} ->
      %{
        module: component,
        data: component_assigns,
        # derive the dispatch kind from the module (Surface vs converted plain,
        # stateless vs live) so WidgetLive's `{#case @widget[:type]}` renders it right
        type: component_assigns[:type] || Bonfire.UI.Common.component_type(component)
      }

    %{} = widget ->
      widget

    other ->
      debug(other, "unsupported")
      nil
  end)
  |> Enum.reject(&is_nil/1)}
  {#match widgets when is_list(widgets) and widgets != []}
    <Bonfire.UI.Common.WidgetsLive
      widgets={widgets}
      page={@page}
      selected_tab={@selected_tab}
      showing_within={:sidebar}
      container_class="widget-list"
      editable={@editable}
      id={e(@widgets, :order_key, nil) ||
        deterministic_dom_id(__MODULE__, nil, "extension_nav_links", @parent_id)}
    />
  {#match _}
    {!-- No widgets --}
{/case}
{!-- here, not in the header: the dashboard hides its header on wide screens --}
<Bonfire.UI.Common.CustomizeWidgetsLive :if={@editable} />
<Bonfire.UI.Common.AddWidgetsLive
  :if={@editable}
  area={:sidebar}
  addable={e(@widgets, :addable, [])}
  class="mt-3"
/>

<aside
  class={"w-full", @class, "p-card flex-auto mx-auto border-y-hair border-divider": @standalone}
  aria-label={@aria_label || @widget_title || nil}
  data-role="widget"
  data-state={hidden_state(@empty, @__context__)}
>
  <div
    :if={@widget_title || slot_assigned?(:action) || (@view_all_to && !@empty) ||
      show_reset?(@reset_cache_event, @can_reset, @__context__)}
    class={"flex items-center justify-between", header_class(@title_class, @section)}
    data-role="widget-header"
  >
    <div :if={@widget_title} class="min-w-0">
      <div
        role="heading"
        aria-level="2"
        data-role="widget-heading"
        class={
          "[.sidebar-widgets_&]:text-base [.sidebar-widgets_&]:leading-[1.3] [.sidebar-widgets_&]:tracking-normal [.sidebar-widgets_&]:normal-case",
          @heading_class,
          "text-lg font-bold! leading-snug tracking-[-0.01em] normal-case": @section
        }
      >{@widget_title}</div>
      <p :if={@widget_subtitle} data-role="widget-subtitle" class="widget-row-meta">{@widget_subtitle}</p>
    </div>
    <div class="flex items-center gap-3 ml-auto">
      {!-- refresh first: hidden until hover, so its space sits left and View all stays flush --}
      {#if show_reset?(@reset_cache_event, @can_reset, @__context__)}
        <button
          type="button"
          phx-click={reset_click(@reset_cache_event, @reset_cache_target)}
          phx-target={@reset_cache_target}
          {...phx_values(@reset_cache_values)}
          onclick="this.dataset.done='1'"
          title={l("Refresh")}
          class="group btn btn-circle touch-target-expanded size-8 min-h-8 min-w-8 p-0 btn-outline border-divider touch-manipulation"
          data-role="widget-reset"
        >
          <span class="touch-target-hit-area" aria-hidden="true" />
          <span class="sr-only">{l("Refresh")}</span>
          <#Icon
            iconify="ph:arrow-counter-clockwise-fill"
            class="size-4 text-primary group-data-[done]:hidden"
          />
          <#Icon iconify="ph:check-bold" class="hidden size-4 text-success group-data-[done]:inline" />
        </button>
      {/if}
      {!-- no header actions when empty: the empty state carries its own action --}
      <#slot :if={!@empty} {@action} />
      {!-- `label` is what `LinkLive` turns into the aria-label, an `aria-label` attribute is not passed on --}
      <LinkLive
        :if={@view_all_to && !@empty}
        to={@view_all_to}
        class="widget-link"
        label={@view_all_label}
      >
        {l("View all")}
      </LinkLive>
    </div>
  </div>
  {#if @empty}
    <#slot {@empty_state}>
      <div
        class="flex flex-col items-center gap-3 px-6 py-3 text-center"
        data-role="widget-empty-state"
      >
        <div class="flex size-10 items-center justify-center rounded-full bg-fill" aria-hidden="true">
          <Iconify.iconify icon={@empty_icon} class="size-5 text-subtle" />
        </div>
        <span class="max-w-[36ch] text-sm text-muted">{@empty_message || l("Nothing here yet.")}</span>
        <#slot {@empty_action} />
      </div>
    </#slot>
  {#else}
    <#slot />
  {/if}
</aside>

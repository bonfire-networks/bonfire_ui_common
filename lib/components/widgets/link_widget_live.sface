{#case active?(@selected_tab, @widget, @__context__)}
  {#match active}
    <LinkLive
      to={if is_function(@to),
        do: @to.(@__context__),
        else: @to}
      id={deterministic_dom_id("link_widget", @parent_id, @order, @page)}
      class={[
        e(@widget[:link_class], @link_class),
        "rounded-selector transition-colors duration-150",
        active_link_class(active)
      ]}
      label={@text || @widget[:text] || @widget[:name]}
      phx_hook={@widget[:phx_hook]}
      opts={if active, do: ["aria-current": "page"], else: []}
    >
      <div class="shrink-0 flex items-center" :if={!@without_icon && (@icon || @widget[:icon])}>
        <Iconify.iconify
          icon={fill_icon(@icon || @widget[:icon])}
          class={[
            @widget[:icon_class] || @icon_class,
            active_icon_class(active)
          ]}
        />
      </div>
      <span class={["text-base", active_label_class(active)]}>{localise_dynamic(
          @text || @widget[:text] || @widget[:name],
          @widget[:extension] || @widget[:module] || __MODULE__
        )}</span>
      {#case @widget[:badge]}
        {#match nil}
        {#match badge}
          <div
            :if={!@skip_badges or (is_list(@skip_badges) and badge[:id] not in @skip_badges)}
            data-id="widget_badge"
            data-highlighted={Settings.get([Bonfire.UI.Common.BadgeCounterLive, :highlight], false, @__context__)}
            class="ml-auto flex shrink-0 items-center place-content-center"
          >
            <StatelessComponent
              module={maybe_component(Bonfire.UI.Common.BadgeCounter, @__context__)}
              badge={badge}
              page={@page}
              widget={@widget}
            />
          </div>
      {/case}
    </LinkLive>
{/case}

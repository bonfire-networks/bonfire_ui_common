<div id={"#{@id}-widget-settings"} class="flex flex-col gap-4">
  <p :if={@widgets == []} class="px-4 text-sm text-muted">{l("There are no widgets to choose from on this instance.")}</p>

  <form
    :if={@widgets != []}
    id={"#{@id}-widgets-form"}
    phx-change="Bonfire.Common.Settings:set"
    class="mx-4"
  >
    <ul
      id={"#{@id}-widgets"}
      phx-hook="Draggable"
      data-event="reorder_widgets"
      data-parent={@id}
      data-sortable-group={inspect(elem(@place, 0))}
      phx-target={@myself}
      class="rounded-box border border-divider divide-y divide-divider overflow-hidden"
    >
      {#for {widget, index} <- Enum.with_index(@widgets)}
        <li
          id={"#{@id}-widget-#{widget.id}"}
          data-sortable-item
          data-item={widget.id}
          data-role="place_widget"
          class="flex items-center gap-2 px-3 py-2"
        >
          <span
            data-sortable-handler
            role="img"
            aria-label={l("Drag to reorder")}
            class="cursor-grab text-subtle hover:text-muted"
          ><#Icon iconify="ph:dots-six-vertical" class="size-4" /></span>
          <div class="flex-1 min-w-0">
            <Bonfire.UI.Common.SettingsToggleLive
              id={"#{@id}_widget_toggle_#{widget.id}"}
              name={widget.name}
              keys={[elem(@place, 0), :include, widget.id]}
              default_value={widget.default}
              scope={@scope}
            />
          </div>
          <button
            :if={widget.move_to}
            type="button"
            data-role="move_widget_area"
            phx-click="move_area"
            phx-value-key={widget.id}
            phx-target={@myself}
            aria-label={if sidebar?(widget.move_to), do: l("Move to sidebar"), else: l("Move to main area")}
            title={if sidebar?(widget.move_to), do: l("Move to sidebar"), else: l("Move to main area")}
            class="btn btn-ghost btn-sm btn-square"
          >
            {#if sidebar?(widget.move_to)}
              <#Icon iconify="ph:arrow-right" class="size-4" />
            {#else}
              <#Icon iconify="ph:arrow-left" class="size-4" />
            {/if}
          </button>
          <Bonfire.UI.Common.MoveButtonsLive
            values={%{key: widget.id}}
            label={widget.name}
            first={index == 0}
            last={index == length(@widgets) - 1}
            target={@myself}
            class="btn btn-ghost btn-sm btn-square"
          />
        </li>
      {/for}
    </ul>
  </form>
</div>

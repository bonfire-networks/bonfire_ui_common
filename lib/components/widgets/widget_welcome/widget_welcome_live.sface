{#case {Bonfire.UI.Common.WidgetWelcomeLive.welcome(),
   Bonfire.UI.Common.WidgetWelcomeLive.show_facts?(@__context__) and
     Bonfire.Common.Extend.module_enabled?(Bonfire.UI.Me.InstanceFactsListLive, @__context__),
   Bonfire.UI.Common.WidgetWelcomeLive.community()}}
  {#match {welcome, show_facts?, community}}
    <div data-id="widget_welcome">
      <Bonfire.UI.Common.WidgetBlockLive aria_label={community.name}>
        <div data-role="widget-body">
          <div class="widget-row" data-role="welcome-header">
            <span aria-hidden="true" class="widget-row-media rounded-full">
              <Bonfire.UI.Common.LogoLive image_class="size-full object-cover" />
            </span>
            <div class="min-w-0">
              <div role="heading" aria-level="2" class="type-heading truncate">{community.name}</div>
              <div :if={community.members} class="widget-row-meta tabular-nums">
                {lp("%{count} person", "%{count} people", community.members, count: community.members)}
              </div>
            </div>
          </div>
          <div :if={welcome} class="max-w-full prose mt-3" data-id="welcome_text">
            <p :if={welcome.title} class="font-medium">{welcome.title}</p>
            {templated_or_remote_markdown(welcome.text, nil)}
          </div>
        </div>
        <div :if={show_facts?} class="mt-4" data-id="welcome_facts">
          <StatelessComponent
            module={maybe_component(Bonfire.UI.Me.InstanceFactsListLive, @__context__)}
            is_guest?={nil}
            list_id="welcome-facts"
          />
        </div>
      </Bonfire.UI.Common.WidgetBlockLive>
    </div>
{/case}

<div
  id={@id}
  data-id="widget_getting_started"
  data-state={Bonfire.UI.Common.WidgetGettingStartedLive.render_state(assigns) |> Atom.to_string()}
  :hook
>
  {#case Bonfire.UI.Common.WidgetGettingStartedLive.render_state(assigns)}
    {#match :hidden}
      {!-- empty: hook hides the parent <li> via dataset.state --}
    {#match state}
      <Bonfire.UI.Common.WidgetBlockLive
        widget_title={l("Getting started")}
        widget_subtitle={if state == :step,
          do: l("Step %{n} of %{total}", n: @viewing_index + 1, total: @total_count)}
        subtitle_class="text-xs tabular-nums text-muted"
      >
        <:action>
          <div class="flex items-center gap-1">
            <.icon_button
              :if={state == :step}
              icon="ph:caret-left"
              aria_label={l("Previous step")}
              size="sm"
              data-id="widget_getting_started_prev"
              phx_click={JS.push("prev", target: @myself)}
              disabled={@total_count <= 1}
            />
            <.icon_button
              :if={state == :step}
              icon="ph:caret-right"
              aria_label={l("Next step")}
              size="sm"
              data-id="widget_getting_started_next"
              phx_click={JS.push("next", target: @myself)}
              disabled={@total_count <= 1}
            />
            <.icon_button
              icon="ph:x"
              aria_label={l("Hide getting started")}
              size="sm"
              data-id="widget_getting_started_dismiss"
              phx_click={JS.push("dismiss", target: @myself)}
            />
          </div>
        </:action>

        {#case state == :step && Bonfire.UI.Common.WidgetGettingStartedLive.viewing_step(assigns)}
          {#match false}
            <div role="status" aria-live="polite">
              <div class="flex gap-1.5 pb-4">
                {#for _step <- @steps}
                  <span class="h-1 flex-1 rounded-sm bg-primary" />
                {/for}
              </div>

              <p class="text-body font-medium text-base-content">{l("You're all set. Welcome to Bonfire.")}</p>
              <p class="text-body text-muted pt-1">{l("Click the X above to tuck this away.")}</p>
            </div>
          {#match nil}
            {!-- defensive — handled by render_state but keeps Surface happy --}
          {#match step}
            <div
              class="flex mb-card"
              role="progressbar"
              aria-valuemin="0"
              aria-valuemax={@total_count}
              aria-valuenow={@done_count}
            >
              {#for {pip_step, idx} <- Enum.with_index(@steps)}
                <span class={[
                  "h-[7px] flex-1 rounded-sm transition-colors duration-300",
                  "bg-primary": pip_step.done?,
                  "bg-primary/40": idx == @viewing_index and not pip_step.done?,
                  "border border-divider": idx != @viewing_index and not pip_step.done?
                ]} />
              {/for}
            </div>

            <div class="flex items-start gap-2">
              <h3 class="flex-1 text-[17px] font-medium text-base-content leading-snug">{step.title}</h3>
              <#Icon
                :if={step.done?}
                iconify="ph:check-circle-fill"
                class="w-5 h-5 text-primary shrink-0 mt-0.5"
                aria-label={l("Done")}
              />
            </div>
            <p class="text-body text-muted pt-1 leading-snug">{step.rationale}</p>

            <div class="pt-4 flex flex-col gap-2">
              {#case step[:cta_kind] || :link}
                {#match :stateful_component}
                  {!-- a step whose action is not somewhere to go but something to do here, like asking this browser for notification permission: the component that owns that flow renders in place of a button, and renders nothing itself where the thing is already done or cannot be offered --}
                  <StatefulComponent
                    module={maybe_component(step[:cta_component], @__context__)}
                    id={"widget_getting_started_#{step.key}"}
                    variant={:compact}
                  />
                {#match :stateless_component}
                  {!-- a step whose action is to read something we can simply show, like the rules, which are a widget rather than a page --}
                  <StatelessComponent module={maybe_component(step[:cta_component], @__context__)} />
                {#match :composer}
                  <button
                    type="button"
                    data-id="widget_getting_started_cta"
                    phx-target="#smart_input"
                    phx-click={Bonfire.UI.Common.SmartInput.LiveHandler.open(%JS{})}
                    class={["btn-ds-outline w-full", "opacity-60": step.done?]}
                  >
                    {if step.done?, do: l("Open again"), else: step.cta_label}
                  </button>
                {#match :button}
                  <button
                    type="button"
                    data-id="widget_getting_started_cta"
                    phx-target={step[:cta_target]}
                    phx-click={step[:cta_event]}
                    class={["btn-ds-outline w-full", "opacity-60": step.done?]}
                  >
                    {if step.done?, do: l("Open again"), else: step.cta_label}
                  </button>
                {#match _}
                  <LinkLive
                    to={step.cta_path}
                    data-id="widget_getting_started_cta"
                    class={["btn-ds-outline w-full", "opacity-60": step.done?]}
                  >
                    {if step.done?, do: l("Open again"), else: step.cta_label}
                  </LinkLive>
              {/case}

              <div :if={not step.done?} class="flex items-center justify-end text-xs text-muted pt-1">
                <button
                  type="button"
                  data-id="widget_getting_started_mark_done"
                  phx-click={JS.push("mark_done", value: %{key: to_string(step.key)}, target: @myself)}
                  class="hover:text-base-content transition-colors"
                >
                  {l("Mark done")}
                </button>
              </div>
            </div>
        {/case}
      </Bonfire.UI.Common.WidgetBlockLive>
  {/case}
</div>

<div
  id="guest-board"
  data-page={@page}
  class="w-full font-(family-name:--font-inter) text-sm leading-relaxed text-base-content [--stream-canvas:var(--color-base-100)] theme-light:text-base-content"
>
  {!-- full-width masthead: icon left, instance name centred, actions right (the 1fr side columns keep the name optically centred whatever the actions' width). No line under it: masthead and tabs read as one header, closed by the nav's border --}
  <header class="grid min-h-14 grid-cols-[1fr_auto_1fr] bg-base-100 items-center gap-4 px-4 sm:min-h-16 sm:px-6">
    <div class="flex min-w-0 items-center">
      {#case Config.get([:ui, :theme, :instance_icon], nil)}
        {#match nil}
        {#match icon}
          {!-- duplicate of the name link below, so it's hidden from assistive tech and the tab order --}
          <LinkLive
            to="/"
            class="inline-flex shrink-0 rounded-box"
            opts={[id: "guest-board-icon", "aria-hidden": "true", tabindex: "-1"]}
          >
            <Bonfire.UI.Common.NextGenImageLive
              src={icon}
              alt=""
              class="size-9 rounded-box object-contain sm:size-10"
              loading="eager"
              fetchpriority="high"
            />
          </LinkLive>
      {/case}
    </div>

    <LinkLive
      to="/"
      class="min-w-0 truncate py-2.5 text-center text-lg font-bold tracking-[-0.01em] underline-offset-3 hover:underline sm:text-xl theme-light:font-bold"
      opts={[id: "guest-board-home"]}
    >{instance_name()}</LinkLive>

    {!-- desktop only: below `lg` the guest mobile dock carries the same actions (see `layout_live.sface`) --}
    <div class="max-lg:hidden flex min-w-0 items-center justify-end gap-2">
      <Bonfire.UI.Common.GuestAuthActionsLive
        login_id="guest-board-signin"
        signup_id="guest-board-signup"
        login_class="btn btn-ghost shrink-0 px-4 whitespace-nowrap"
        signup_class="btn btn-primary shrink-0 px-4 whitespace-nowrap"
      />
    </div>
  </header>

  <nav
    id="guest-board-nav"
    class="overflow-x-auto border-b border-divider bg-base-100 px-4 [scrollbar-width:none] sm:px-6"
    aria-label={l("Community")}
  >
    {!-- `w-max mx-auto` centres the tabs when they fit and lets them scroll (instead of clipping the first one) when they don't --}
    <ul class="mx-auto flex w-max gap-5 sm:gap-7">
      <li :for={{page, path, label} <- nav_items(@__context__)}>
        <LinkLive
          to={path}
          class="inline-flex min-h-12 items-center whitespace-nowrap border-b-2 border-transparent text-sm text-muted hover:text-base-content aria-[current=page]:border-current aria-[current=page]:font-medium aria-[current=page]:text-base-content"
          opts={current_opts(@page, page)}
        >{label}</LinkLive>
      </li>
    </ul>
  </nav>

  {!-- the page as raised cards on the tinted canvas; the gap between cards is the separation, so no section draws its own top border --}
  <div class="mx-auto flex w-full max-w-205 flex-col gap-4 px-3 pb-10 pt-4 sm:px-0 sm:pb-12 sm:pt-6">
    {#if slot_assigned?(:hero)}
      {!-- stacked, not split: the intro is instance-authored (any length, markdown), so it gets the full card width below a short banner --}
      <section id="guest-board-hero" class="board-card">
        {!-- flush with the card's edges: the card clips it to its own rounded corners. Same ratio as the other pages' banner below, so it's the same height everywhere on the board --}
        <div
          :if={banner_image()}
          data-role="guest-board-banner"
          class="aspect-[5/2] bg-fill bg-cover bg-center sm:aspect-[4/1]"
          aria-hidden="true"
          style={Bonfire.UI.Common.NextGenImageLive.background_image_set(banner_image())}
        />
        <#slot {@hero} />
      </section>
    {/if}

    {#if @bare}
      <#slot />
    {#else}
      <div class="board-card">
        <div
          :if={!slot_assigned?(:hero)}
          data-role="guest-board-banner"
          class={
            "aspect-[5/2] bg-cover bg-center sm:aspect-[4/1]",
            "bg-fill": is_binary(banner_image()),
            "bg-fill-strong": is_nil(banner_image())
          }
          aria-hidden="true"
          style={Bonfire.UI.Common.NextGenImageLive.background_image_set(banner_image())}
        />
        <#slot />
      </div>
    {/if}
  </div>

  <footer id="guest-board-footer" class="pb-6">
    <ul class="mx-auto flex w-full max-w-205 flex-wrap gap-x-4 px-5 text-xs text-muted sm:px-6">
      <li :for={{path, label} <- footer_pages()}><LinkLive
          to={path}
          class="inline-flex min-h-11 items-center gap-1 underline-offset-3 hover:text-base-content hover:underline"
        >{label}</LinkLive></li>
      <li :for={{name, url} <- community_links()}><a
          href={url}
          target="_blank"
          rel="noopener"
          class="inline-flex min-h-11 items-center gap-1 underline-offset-3 hover:text-base-content hover:underline"
        >{name}</a></li>
      <li>
        <a
          href={Bonfire.UI.Common.ImpressumLive.powered_by_url()}
          target="_blank"
          rel="noopener"
          class="inline-flex min-h-11 items-center gap-1 underline-offset-3 hover:text-base-content hover:underline"
        >
          {l("Powered by %{name}", name: Bonfire.UI.Common.ImpressumLive.powered_by_name())}
          <#Icon iconify="ph:arrow-up-right" class="size-3" aria-hidden="true" />
        </a>
      </li>
    </ul>
  </footer>
</div>

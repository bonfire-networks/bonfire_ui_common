<div
  id="smart_input_live"
  class="flex flex-col h-full md:h-full pt-safe rounded-box flex-1 bg-base-100 grow relative z-[] min-h-0"
>
  <div
    id="composer_container"
    data-id="smart_input"
    class="flex flex-col flex-1 h-full grow rounded-box min-h-0"
  >
    <div
      id="smart_input"
      phx-drop-target={@uploads.files.ref}
      class="flex bg-transparent rounded-box h-full grow flex-1 min-h-0"
    >
      <div
        :if={not is_nil(current_user_id(@__context__))}
        class="relative overflow-hidden lg:max-h-[95vh] min-h-0 flex flex-col flex-1 w-full bg-base-100 rounded-box z-max"
      >
        <!-- <Bonfire.UI.Common.SmartInputHeaderModalLive smart_input_opts={@smart_input_opts} /> -->
        <header
          :if={@showing_within != :thread_embed}
          id="composer_header"
          class="z-[51] flex shrink-0 flex-col w-full sticky top-0 lg:rounded-t-box bg-base-100 md:z-auto md:relative"
        >
          <div
            id="composer_resize_handle"
            data-role="composer_resize"
            role="separator"
            tabindex="0"
            aria-orientation="horizontal"
            aria-label={l("Resize composer")}
            aria-controls="smart_input"
            aria-valuemin="360"
            aria-valuemax="900"
            aria-valuenow="500"
            title={l("Drag to resize, or use Up and Down arrow keys")}
            class="composer-resize-handle focus-ring"
          ><span aria-hidden="true" /></div>
          {!-- replaces the header while the phone keyboard is open (:root[data-composer-keyboard]); a tap brings the controls back. Not for messages --}
          <div
            :if={replying?(assigns) or e(@smart_input_opts, :create_object_type, nil) not in ["message", :message]}
            class="composer-summary items-center gap-1 pt-1 pr-2"
          >
            <button
              id="composer_summary"
              type="button"
              aria-controls={if replying?(assigns), do: "reply_peek composer_header_actions", else: "composer_header_actions"}
              aria-expanded="false"
              phx-click={JS.toggle_attribute({"data-controls-open", ""}, to: "#composer_header")
              |> JS.toggle_attribute({"aria-expanded", "true", "false"})}
              class="flex min-h-8 min-w-0 flex-1 items-center gap-2 px-3 text-left text-sm focus-ring"
            >
              <Bonfire.UI.Common.AvatarLive
                bg_class="rounded-full"
                wrapper_class="border-0 avatar !flex size-6 shrink-0"
                class="inline-block object-cover w-full rounded-full"
                src={Media.avatar_url(current_user(@__context__)) || @__context__[:current_user_avatar_url]}
                user_id={current_user_id(@__context__)}
                parent_id="composer_summary"
                is_remote={false}
              />
              <span :if={replying?(assigns)} class="min-w-0 flex-1 truncate text-muted">
                {#case reply_to_author(assigns)}
                  {#match %{name: who_name, handle: who_handle}}
                    {l("Reply to")} <span class="font-medium text-base-content">{who_name || who_handle || l("this post")}</span>
                {/case}
                · {reply_audience_label(@to_boundaries)}
              </span>
              {!-- only the place truncates; the audience is an icon, as on the desktop chip --}
              <span :if={!replying?(assigns)} class="flex min-w-0 flex-1 items-baseline gap-1 text-muted">
                <span class="shrink-0 font-medium text-base-content">{LiveHandler.type_label(
                    LiveHandler.active_smart_input_component(nil, e(@smart_input_opts, :create_object_type, nil)),
                    e(@smart_input_opts, :create_object_type, nil)
                  )}</span>
                <span class="min-w-0 truncate">· <span
                    :if={topic_context?(@context_group) and e(@context_group, :group_name, nil)}
                    class="sr-only"
                  >{@context_group.group_name} ›</span>{summary_destination_label(@context_group)}</span>
                <span
                  class="flex shrink-0 items-center self-center"
                  title={summary_audience_label(
                    @to_boundaries,
                    @to_circles,
                    @exclude_circles,
                    @verb_permissions,
                    @context_group
                  )}
                >
                  <Iconify.iconify
                    icon={summary_audience_icon(
                      @to_boundaries,
                      @to_circles,
                      @exclude_circles,
                      @verb_permissions,
                      @context_group
                    )}
                    class="size-4 opacity-70"
                  />
                  <span class="sr-only">· {summary_audience_label(
                      @to_boundaries,
                      @to_circles,
                      @exclude_circles,
                      @verb_permissions,
                      @context_group
                    )}</span>
                </span>
              </span>
              <#Icon iconify="ph:caret-down" class="composer-summary-caret size-3.5 shrink-0 text-muted" />
            </button>
            {!-- one tap to minimise while typing: the header's own minimise button is hidden with the controls --}
            <button
              id="minimize_composer_summary_button"
              phx-click={LiveHandler.minimize()}
              phx-target="#smart_input"
              type="button"
              aria-label={l("Minimise composer, keep draft")}
              title={l("Minimise composer, keep draft")}
              class="btn btn-sm btn-ghost btn-circle text-muted focus-ring"
            ><#Icon iconify="ph:minus" class="size-4" /></button>
          </div>
          <section
            :if={replying?(assigns)}
            id="reply_peek"
            aria-label={l("Original post")}
            class="reply_in_composer flex gap-2 px-3 pt-2 sm:px-4"
          >{!-- the post being replied to, above your avatar and joined to it by a thread line; capped so the editor stays in view on phones --}
            <div class="flex w-8 shrink-0 flex-col items-center">
              {#case reply_to_subject(assigns)}
                {#match nil}
                  <span class="size-8 rounded-full bg-fill" aria-hidden="true" />
                {#match subject}
                  <Bonfire.UI.Common.AvatarLive
                    bg_class="rounded-full"
                    wrapper_class="border-0 avatar !flex size-8"
                    class="inline-block object-cover w-full rounded-full"
                    src={Media.avatar_url(subject)}
                    user_id={id(subject)}
                    parent_id="reply_peek"
                  />
              {/case}
              <span class="mt-1 w-0.5 flex-1 rounded-full bg-divider" aria-hidden="true" />
            </div>
            <div class="reply-peek-body min-w-0 flex-1 pb-2">
              {#case reply_to_author(assigns)}
                {#match %{name: who_name, handle: who_handle}}
                  <p :if={who_name || who_handle} class="flex min-w-0 items-baseline gap-1.5">
                    <span class="truncate font-medium text-base-content">{who_name || who_handle}</span>
                    <span :if={who_name && who_handle} class="truncate text-muted">{who_handle}</span>
                  </p>
              {/case}
              <div class="reply-peek-text">
                <StatelessComponent
                  module={maybe_component(Bonfire.UI.Social.ActivityLive, @__context__)}
                  activity_component_id={deterministic_dom_id(
                    __MODULE__,
                    id(@reply_to_id) || id(@object) || id(@activity),
                    e(@reply_to_id, nil)
                  )}
                  myself={nil}
                  activity={@activity}
                  cw={e(post_content(@object), :summary, nil)}
                  object={@object || @reply_to_id}
                  thread_mode={:nested}
                  class={@replied_activity_class}
                  hide_activity="subject"
                  show_minimal_subject_and_note={Bonfire.UI.Social.ActivityLive.name_or_text(@object) || true}
                  showing_within={:smart_input}
                  activity_inception={@activity_inception}
                  object_boundary={@reply_to_boundary}
                />
              </div>
              <button
                :if={reply_peek_long?(@object || @reply_to_id)}
                id="reply_peek_more"
                type="button"
                aria-controls="reply_peek"
                aria-expanded="false"
                phx-click={JS.toggle_attribute({"data-expanded", ""}, to: "#reply_peek")
                |> JS.toggle_attribute({"aria-expanded", "true", "false"})}
                class="reply-peek-more mt-0.5 rounded text-sm font-medium text-primary hover:underline focus-ring"
              >
                <span class="reply-peek-more-label">{l("See more")}</span>
                <span class="reply-peek-less-label">{l("See less")}</span>
              </button>
            </div>
          </section>
          <div id="composer_header_actions" class="flex items-start gap-2 px-3 pt-1 pb-0.5 sm:px-4">
            <div id="composer_author" class="flex h-10 shrink-0 items-center">
              <div
                class="shrink-0"
                title={e(current_user(@__context__), :profile, :name, nil) ||
                  e(current_user(@__context__), :character, :username, nil)}
              >
                <Bonfire.UI.Common.AvatarLive
                  bg_class="rounded-full"
                  ring
                  title={e(current_user(@__context__), :profile, :name, "Anon")}
                  wrapper_class="border-0 avatar !flex size-8"
                  class="inline-block object-cover w-full rounded-full"
                  src={Media.avatar_url(current_user(@__context__)) || @__context__[:current_user_avatar_url]}
                  user_id={current_user_id(@__context__)}
                  parent_id="smart_input"
                  is_remote={false}
                />
              </div>
              <div class="min-w-0">
                <span class="sr-only">{l("Posting as")}</span>
                <span class="sr-only">{e(current_user(@__context__), :profile, :name, nil) ||
                    e(current_user(@__context__), :character, :username, nil)}</span>
              </div>
            </div>

            <div id="composer_sentence" class="flex min-w-0 flex-1 flex-wrap items-center gap-x-2 gap-y-1.5">{!-- the mode as text, then where and who as chips: "Create post ▾ [Your profile] [Public]"; each chip is a menu with an sr-only label --}
              {#if e(@smart_input_opts, :create_object_type, nil) not in ["message", :message] and
                  @reply_to_id in [nil, ""] and @showing_within != :thread_embed}
                {#case Bonfire.UI.Common.SmartInputModule.modules() |> Enum.uniq()}
                  {#match [_, _ | _] = available_types}
                    {#case LiveHandler.active_smart_input_component(
                        nil,
                        e(@smart_input_opts, :create_object_type, nil)
                      )}
                      {#match active_component}
                        <Dropdown
                          wrapper_opts={["data-boundary": "#composer_container"]}
                          id="composer_type_chooser"
                          position="bottom-start"
                          trigger_class="flex min-h-10 min-w-0 max-w-full items-center gap-1.5 rounded-selector px-1.5 text-left text-sm font-medium hover:bg-fill focus-ring"
                          label={l("Choose what to create")}
                          trigger_opts={[title: l("Choose what to create")]}
                        >
                          <:trigger>
                            <span class="normal-case">
                              {LiveHandler.type_label(active_component, e(@smart_input_opts, :create_object_type, nil))}
                            </span>
                            <#Icon iconify="ph:caret-down" class="size-3.5 shrink-0 text-muted" />
                          </:trigger>

                          <li :for={component <- available_types}>
                            <a
                              phx-click={LiveHandler.open_type(%JS{}, component, @smart_input_opts)}
                              phx-target="#smart_input"
                              aria-current={if component == active_component, do: "true"}
                              class={
                                "flex items-center gap-2",
                                active: component == active_component
                              }
                            >
                              <Iconify.iconify icon={LiveHandler.type_icon(component)} class="size-4 shrink-0 text-muted" />
                              <span>{LiveHandler.type_label(component)}</span>
                            </a>
                          </li>
                        </Dropdown>
                    {/case}
                  {#match _}
                {/case}
              {/if}

              <Dropdown
                :if={replying?(assigns)}
                wrapper_opts={["data-boundary": "#composer_container"]}
                id="composer_reply_actions"
                menu={false}
                close_on_select
                position="bottom-start"
                wrapper_class="min-w-0"
                trigger_class="flex min-h-10 min-w-0 max-w-full items-center gap-1.5 rounded-selector px-1.5 text-left text-sm font-medium hover:bg-fill focus-ring"
                panel_class="!w-72 max-w-[calc(100vw-2rem)] !p-1.5"
              >
                <:trigger>
                  <#Icon iconify="ph:arrow-bend-up-left" class="size-4 shrink-0 text-muted" />
                  {#case reply_to_author(assigns)}
                    {#match %{name: who_name, handle: who_handle}}
                      <span class="min-w-0 truncate" aria-hidden="true">{l("Reply")}</span>
                      <span class="sr-only">{l("Replying to %{name}", name: who_name || who_handle || l("this post"))}</span>
                  {/case}
                  <#Icon iconify="ph:caret-down" class="size-3.5 shrink-0 text-muted" />
                </:trigger>
                <Bonfire.UI.Common.OpenModalLive
                  id="convert_reply"
                  reusable_modal_id="persistent_modal"
                  title_text={l("Remove reply?")}
                  open_btn_text={l("Remove reply")}
                  open_btn_aria_label={l("Remove reply")}
                  open_modal_wrapper_class="w-full"
                  open_btn_wrapper_class="flex min-h-11 items-start gap-3 rounded-selector px-3 py-2.5 text-left hover:bg-base-200 focus-ring"
                  without_form
                >
                  <:open_btn>
                    <#Icon iconify="ph:arrow-bend-up-left" class="mt-0.5 size-5 shrink-0 text-muted" />
                    <span class="min-w-0">
                      <span class="block text-sm font-medium">{l("Remove reply")}</span>
                      <span class="mt-0.5 block text-xs text-muted">{l("Keep your draft as a new post")}</span>
                    </span>
                  </:open_btn>
                  <p>{l("Keep your text and attachments and turn this reply into a new post.")}</p>
                  <p class="text-sm text-muted">{l("You can change the destination and visibility before publishing. Nothing will be posted now.")}</p>
                  <:cancel_btn><button id="keep_replying" type="button" class="btn btn-ghost">{l("Keep replying")}</button></:cancel_btn>
                  <:action_btns>
                    <button
                      id="confirm_standalone_post"
                      type="button"
                      phx-click="Bonfire.UI.Common.SmartInput:remove_data"
                      phx-target="#smart_input"
                      class="btn btn-primary"
                    >{l("Remove reply")}</button>
                  </:action_btns>
                </Bonfire.UI.Common.OpenModalLive>
              </Dropdown>
              <div
                id="composer_policy_controls"
                role="group"
                aria-label={l("Audience and permissions")}
                class="flex min-w-0 flex-1 basis-56 items-center gap-2"
              >{!-- a small flex-basis keeps the chips on the "Create post" line while ~14rem is left, so they
                  truncate (group name first) instead of the whole group wrapping; no inner wrap for the same reason --}
                {#if e(@smart_input_opts, :create_object_type, nil) in ["message", :message]}
                  <span
                    class="flex min-h-10 items-center gap-1.5 px-1.5 text-sm text-warning"
                    title={l(
                      "Messages on the fediverse are not currently end-to-end encrypted. Do not share any sensitive information."
                    )}
                  >
                    <#Icon iconify="ph:lock-simple-open-fill" class="size-4" />
                    {l("Not encrypted")}
                  </span>
                  <button
                    :if={!replying?(assigns) and @showing_within != :messages}
                    id="composer_switch_to_post"
                    type="button"
                    phx-click="Bonfire.UI.Common.SmartInput:switch_to_post"
                    phx-target="#smart_input"
                    class="btn btn-ghost btn-xs text-base-content focus-ring"
                  >
                    <#Icon iconify="ph:note-pencil" class="size-4" />
                    {l("Switch to post")}
                  </button>
                {#elseif replying?(assigns) or group_context?(@context_group) or @showing_within != :thread_embed}
                  {!-- Where it's posted, then who can see it. In thread_embed the boundary follows the
                      parent thread, so personal posts get no policy controls there. --}
                  {#if replying?(assigns)}
                    <span
                      :if={e(@smart_input_opts, :reply_destination, nil)}
                      id="composer_reply_destination"
                      data-role="reply_destination"
                      class="flex h-8 min-w-0 max-w-full items-center gap-1.5 text-sm text-muted"
                    >
                      <span class="sr-only">{l("Reply in")}</span>
                      <#Icon iconify="ph:chats" class="size-4 shrink-0" />
                      <span class="min-w-0 truncate">
                        <span :if={e(@smart_input_opts, :reply_destination, :group_name, nil)}>{e(@smart_input_opts, :reply_destination, :group_name, nil)} /</span>
                        {e(@smart_input_opts, :reply_destination, :name, nil)}
                      </span>
                    </span>
                  {#else}
                    <StatefulComponent
                      module={maybe_component(Bonfire.UI.Boundaries.AudiencePickerLive, @__context__)}
                      id="composer_audience_picker"
                      mode={:destination}
                      to_boundaries={@to_boundaries}
                      context_group={@context_group}
                      event_target={@event_target}
                    />
                  {/if}
                  {#if replying?(assigns)}
                    <Bonfire.UI.Common.PolicyDropdownLive
                      id="composer_reply_visibility"
                      label={l("Visible to")}
                      icon="ph:shield-check-duotone"
                      selected_label={reply_audience_label(@to_boundaries)}
                      description={l(
                        "Replies use the original post's visibility by default. Narrower audiences still include the original author."
                      )}
                      options={reply_audience_options(@smart_input_opts, @to_boundaries)}
                      event="Bonfire.UI.Common.SmartInput:select_reply_audience"
                      option_attr="data-reply-audience"
                      emphasis={reply_audience_narrowed?(@to_boundaries)}
                      event_target={@event_target}
                    />
                  {#elseif group_context?(@context_group)}
                    <Bonfire.UI.Common.PolicyDropdownLive
                      id="composer_group_visibility"
                      label={l("Visible to")}
                      icon={group_audience_icon(@to_boundaries, @exclude_circles, @verb_permissions)}
                      selected_label={group_audience_label(@to_boundaries, @exclude_circles, @verb_permissions)}
                      status_opts={["data-role": "group-composer-audience"]}
                      description={l("Choose who can see this post within the group's rules.")}
                      options={group_audience_options(@context_group, @to_boundaries)}
                      event="Bonfire.UI.Common.SmartInput:select_group_audience"
                      option_attr="data-group-audience"
                      icon_only={topic_context?(@context_group)}
                      event_target={@event_target}
                    />
                  {#else}
                    <StatelessComponent
                      module={maybe_component(Bonfire.UI.Boundaries.SetBoundariesButtonLive, @__context__)}
                      to_boundaries={@to_boundaries}
                      boundary_preset={@boundary_preset}
                      preview_boundary_for_id={@preview_boundary_for_id}
                      preview_boundary_for_username={@preview_boundary_for_username}
                      preview_boundary_verbs={@preview_boundary_verbs}
                      to_circles={@to_circles}
                      exclude_circles={@exclude_circles}
                      verb_permissions={@verb_permissions}
                      setting_boundaries={:create_object}
                      context_id={@context_id}
                      context_group={@context_group}
                      event_target={@event_target}
                    />
                  {/if}
                {/if}
              </div>
            </div>
            <div class="flex h-10 shrink-0 items-center">
              <button
                id="expand_composer_button"
                data-role="composer_fullscreen"
                data-expand-label={l("Expand composer")}
                data-restore-label={l("Restore composer size")}
                type="button"
                aria-label={l("Expand composer")}
                title={l("Expand composer")}
                aria-pressed="false"
                class="composer-fullscreen-button btn btn-sm btn-ghost btn-circle text-muted focus-ring"
              >
                <span class="composer-expand-icon"><#Icon iconify="ph:arrows-out-simple" class="size-4" /></span>
                <span class="composer-restore-icon"><#Icon iconify="ph:arrows-in-simple" class="size-4" /></span>
              </button>
              <button
                id="minimize_composer_button"
                phx-click={LiveHandler.minimize()}
                phx-target="#smart_input"
                type="button"
                aria-label={l("Minimise composer, keep draft")}
                title={l("Minimise composer, keep draft")}
                class="btn btn-sm btn-ghost btn-circle text-muted focus-ring"
              ><#Icon iconify="ph:minus" class="size-4" /></button>
              <span id="composer_close" class="flex">
                {#if @smart_input_opts[:input_status] == :draft}
                  <Bonfire.UI.Common.OpenModalLive
                    id="discard_composer"
                    without_form
                    reusable_modal_id="persistent_modal"
                    title_text={l("Discard draft?")}
                    cancel_label={l("Keep editing")}
                    open_modal_wrapper_class="flex"
                    open_btn_wrapper_class="btn btn-sm btn-ghost btn-circle !w-8 text-muted focus-ring"
                    open_btn_aria_label={l("Close and discard draft")}
                    open_btn_opts={[title: l("Close and discard draft")]}
                  >
                    <div class="mt-3 prose-sm prose">
                      <p>{l("Discard this draft? This cannot be undone.")}</p>
                    </div>
                    <:open_btn>
                      <#Icon iconify="ph:x" class="size-4" />
                    </:open_btn>
                    <:action_btns>
                      <button
                        phx-click={JS.push("Bonfire.UI.Common.SmartInput:reset_to_default")
                        |> JS.push("close", target: "#persistent_modal")
                        |> JS.add_class("translate-y-100", to: "#smart_input_container")}
                        phx-target="#smart_input"
                        type="button"
                        class="normal-case btn btn-sm btn-error"
                      >
                        {l("Discard draft")}
                      </button>
                    </:action_btns>
                  </Bonfire.UI.Common.OpenModalLive>
                {#else}
                  <button
                    id="close_composer_button"
                    type="button"
                    phx-click={LiveHandler.minimize()}
                    phx-target="#smart_input"
                    aria-label={l("Close composer")}
                    title={l("Close composer")}
                    class="btn btn-sm btn-ghost btn-circle text-muted focus-ring"
                  ><#Icon iconify="ph:x" class="size-4" /></button>{!-- hides without resetting: input_status lags typing, so text typed since the last validate is kept, not discarded --}
                {/if}
              </span>
            </div>
          </div>
        </header>

        {!-- TEMPORARY mock-up for #2352/#2303, not wired: remove once the design is decided. Behind the app-wide `:show_unimplemented` flag, which dev turns on.
             Commented out (not deleted) now that the composer implements this design; the component stays for reference.
        <Bonfire.UI.Common.ComposerHeaderMockupLive
          :if={show_unimplemented?() and @showing_within != :thread_embed and
            e(@smart_input_opts, :create_object_type, nil) not in ["message", :message]}
          context_group={@context_group}
        />
        --}

        <div :if={is_map(@quoted_object)} id="quote_in_composer" class="">
          <div class="quote_in_composer relative max-h-40 overflow-y-auto overflow-x-hidden border-hair border-divider bg-base-100">
            <header class="sticky top-0 rounded-t-box z-10 flex items-center justify-between gap-2 px-3 py-1.5 bg-base-200 backdrop-blur-sm border-b-hair border-divider">
              <span class="inline-flex items-center gap-1.5 text-sm text-base-content">
                <#Icon iconify="ph:quotes-fill" class="size-3.5 text-primary" />
                {l("Quoting")}
              </span>

              <button
                type="button"
                phx-click="Bonfire.UI.Common.SmartInput:remove_quoted"
                phx-target="#smart_input"
                class="inline-flex cursor-pointer items-center gap-1 text-xs text-muted hover:text-base-content"
                title={l("Remove quote")}
                aria-label={l("Remove quote")}
              >
                <#Icon iconify="ph:x-bold" class="size-3.5" />
                <span class="hidden sm:inline">{l("Remove")}</span>
              </button>
            </header>

            <div class="p-2">
              <StatelessComponent
                module={maybe_component(Bonfire.UI.Social.ActivityLive, @__context__)}
                activity_component_id={deterministic_dom_id(__MODULE__, id(@quoted_object), :quoted)}
                myself={nil}
                activity={e(@quoted_object, :activity, nil)}
                object={@quoted_object}
                thread_mode={:nested}
                class="quoted_activity"
                show_minimal_subject_and_note={Bonfire.UI.Social.ActivityLive.name_or_text(@quoted_object) ||
                  true}
                hide_actions
                showing_within={:smart_input}
                object_boundary={@quoted_boundary}
              />
            </div>
          </div>
        </div>

        <div
          :if={e(@activity, :subject, nil) != nil and
            !Bonfire.Social.is_local?(
              e(@activity, :subject, nil),
              false
            ) and
            !maybe_apply(Bonfire.Federate.ActivityPub, :federating?, current_user(@__context__),
              context: @__context__,
              fallback_return: false
            )}
          class="badge badge-warning m-2 mb-0 h-auto"
        >{l(
            "Warning: You are replying to a remote activity but federation is disabled. This means only users on your local instance will see your reply unless federation is later turned on."
          )}</div>

        {#case LiveHandler.active_smart_input_component(
            @smart_input_component,
            e(@smart_input_opts, :create_object_type, nil)
          )}
          {#match module}
            {#if function_exported?(module, :mount, 1)}
              <StatefulComponent
                id="smart_input_component"
                module={module}
                textarea_class={Surface.css_class(["editor_area textarea p-0 w-full rounded-none"])}
                {...assigns}
              />
            {#else}
              <StatelessComponent
                module={module}
                textarea_class={Surface.css_class(["editor_area textarea p-0 w-full rounded-none"])}
                {...assigns}
              />
            {/if}
        {/case}
      </div>
    </div>
  </div>
</div>

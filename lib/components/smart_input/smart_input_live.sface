<div
  id="smart_input_live"
  class="flex flex-col h-full md:h-full pt-safe rounded-xl flex-1 bg-base-100 grow relative z-[] min-h-0"
>
  <div
    id="composer_container"
    data-id="smart_input"
    class="flex flex-col flex-1 h-full grow rounded-xl min-h-0"
  >
    <div
      id="smart_input"
      phx-drop-target={@uploads.files.ref}
      class="flex bg-transparent rounded-xl h-full grow flex-1 min-h-0"
    >
      <div
        :if={not is_nil(current_user_id(@__context__))}
        class="relative overflow-hidden lg:max-h-[95vh] min-h-0 flex flex-col flex-1 w-full bg-base-100 rounded-xl z-max"
      >
        <!-- <Bonfire.UI.Common.SmartInputHeaderModalLive smart_input_opts={@smart_input_opts} /> -->
        <header
          :if={@showing_within != :thread_embed}
          class="z-50 flex shrink-0 flex-col w-full sticky top-0 border-b border-base-content/10 lg:rounded-t-xl bg-base-100 md:z-auto md:relative"
        >
          <div
            id="composer_resize_handle"
            data-role="composer_resize"
            role="separator"
            tabindex="0"
            aria-orientation="horizontal"
            aria-label={l("Resize composer")}
            aria-controls="smart_input"
            aria-valuemin="360"
            aria-valuemax="900"
            aria-valuenow="500"
            title={l("Drag to resize, or use Up and Down arrow keys")}
            class="composer-resize-handle focus-ring"
          ><span aria-hidden="true"></span></div>
          <div id="composer_header_actions" class="flex items-center gap-2 px-4 py-1">
            <div id="composer_author" class="flex shrink-0 items-center">
              <div
                class="shrink-0"
                title={e(current_user(@__context__), :profile, :name, nil) ||
                  e(current_user(@__context__), :character, :username, nil)}
              >
                <Bonfire.UI.Common.AvatarLive
                  bg_class="rounded-full"
                  ring
                  title={e(current_user(@__context__), :profile, :name, "Anon")}
                  wrapper_class="border-0 avatar !flex w-7 h-7"
                  class="inline-block object-cover w-full rounded-full"
                  src={Media.avatar_url(current_user(@__context__)) || @__context__[:current_user_avatar_url]}
                  user_id={current_user_id(@__context__)}
                  parent_id="smart_input"
                  is_remote={false}
                />
              </div>
              <div class="min-w-0">
                <span class="sr-only">{l("Posting as")}</span>
                <span class="sr-only">{e(current_user(@__context__), :profile, :name, nil) || e(current_user(@__context__), :character, :username, nil)}</span>
              </div>
            </div>

              {#if e(@smart_input_opts, :create_object_type, nil) not in ["message", :message] and
                  @reply_to_id in [nil, ""] and @showing_within != :thread_embed}
                {#case Bonfire.UI.Common.SmartInputModule.modules() |> Enum.uniq()}
                  {#match [_, _ | _] = available_types}
                    {#case LiveHandler.active_smart_input_component(
                        nil,
                        e(@smart_input_opts, :create_object_type, nil)
                      )}
                      {#match active_component}
                        <Dropdown
                          wrapper_opts={["data-boundary": "#composer_container"]}
                          id="composer_type_chooser"
                          position="bottom-start"
                          trigger_class="flex min-h-11 items-center gap-2 rounded-lg px-2 text-left font-semibold hover:bg-base-content/5 focus-ring"
                          label={l("Choose what to create")}
                          trigger_opts={[title: l("Choose what to create")]}
                        >
                          <:trigger>
                            <Iconify.iconify
                              icon={LiveHandler.type_icon(active_component, e(@smart_input_opts, :create_object_type, nil))}
                              class="w-5 h-5"
                            />
                            <span class="text-sm normal-case">
                              {LiveHandler.type_label(active_component, e(@smart_input_opts, :create_object_type, nil))}
                            </span>
                            <#Icon iconify="carbon:chevron-down" class="w-3 h-3 text-muted" />
                          </:trigger>

                          <li :for={component <- available_types}>
                            <a
                              phx-click={LiveHandler.open_type(%JS{}, component, @smart_input_opts)}
                              phx-target="#smart_input"
                              aria-current={if component == active_component, do: "true"}
                              class={
                                "flex items-center gap-2",
                                active: component == active_component
                              }
                            >
                              <Iconify.iconify icon={LiveHandler.type_icon(component)} class="w-4 h-4 shrink-0 text-muted" />
                              <span>{LiveHandler.type_label(component)}</span>
                            </a>
                          </li>
                        </Dropdown>
                    {/case}
                  {#match _}
                {/case}
              {/if}

            <Dropdown :if={replying?(assigns)}
              wrapper_opts={["data-boundary": "#composer_container"]}
              id="composer_reply_actions"
              menu={false}
              close_on_select
              position="bottom-start"
              wrapper_class="min-w-0"
              trigger_class="flex min-h-11 min-w-0 max-w-full items-center gap-2 rounded-lg px-2 text-left hover:bg-base-content/5 focus-ring"
              panel_class="!w-72 max-w-[calc(100vw-2rem)] !p-1.5"
            >
              <:trigger>
                <#Icon iconify="ph:arrow-bend-up-left" class="size-5 shrink-0 text-primary" />
                {#case reply_to_author(assigns)}
                  {#match %{name: who_name, handle: who_handle}}
                    <span class="min-w-0 truncate text-sm font-semibold">{l("Replying to %{name}", name: who_name || who_handle || l("this post"))}</span>
                {/case}
                <#Icon iconify="ph:caret-down" class="size-4 shrink-0 text-muted" />
              </:trigger>
              <button id="toggle_reply_preview" type="button" aria-controls="reply_peek" aria-expanded="false"
                phx-click={JS.toggle_attribute({"hidden", ""}, to: "#reply_peek") |> JS.toggle_attribute({"aria-expanded", "true", "false"})}
                class="group flex w-full min-h-11 items-center gap-3 rounded-lg px-3 py-2.5 text-left text-sm hover:bg-base-200 focus-ring">
                <#Icon iconify="ph:text-align-left" class="size-5 shrink-0 text-muted" />
                <span class="group-aria-expanded:hidden">{l("Show original post")}</span>
                <span class="hidden group-aria-expanded:inline">{l("Hide original post")}</span>
              </button>
            <Bonfire.UI.Common.OpenModalLive
              id="convert_reply"
              reusable_modal_id="persistent_modal"
              title_text={l("Remove reply?")}
              open_btn_text={l("Remove reply")}
              open_btn_aria_label={l("Remove reply")}
              open_modal_wrapper_class="w-full"
              open_btn_wrapper_class="flex min-h-11 items-start gap-3 rounded-lg px-3 py-2.5 text-left hover:bg-base-200 focus-ring"
              without_form
            >
              <:open_btn>
                <#Icon iconify="ph:arrow-bend-up-left" class="mt-0.5 size-5 shrink-0 text-muted" />
                <span class="min-w-0">
                  <span class="block text-sm font-medium">{l("Remove reply")}</span>
                  <span class="mt-0.5 block text-xs text-muted">{l("Keep your draft as a new post")}</span>
                </span>
              </:open_btn>
              <p>{l("Keep your text and attachments and turn this reply into a new post.")}</p>
              <p class="text-sm text-muted">{l("You can change the destination and visibility before publishing. Nothing will be posted now.")}</p>
              <:cancel_btn><button id="keep_replying" type="button" class="btn btn-ghost">{l("Keep replying")}</button></:cancel_btn>
              <:action_btns>
                <button id="confirm_standalone_post" type="button"
                  phx-click="Bonfire.UI.Common.SmartInput:remove_data" phx-target="#smart_input"
                  class="btn btn-primary">{l("Remove reply")}</button>
              </:action_btns>
            </Bonfire.UI.Common.OpenModalLive>
            </Dropdown>
            <div class="ml-auto flex shrink-0 items-center gap-0.5">
              <button
                id="expand_composer_button"
                data-role="composer_fullscreen"
                data-expand-label={l("Expand composer")}
                data-restore-label={l("Restore composer size")}
                type="button"
                aria-label={l("Expand composer")}
                title={l("Expand composer")}
                aria-pressed="false"
                class="composer-fullscreen-button btn btn-sm btn-ghost btn-circle min-h-11 min-w-11 text-muted focus-ring"
              >
                <span class="composer-expand-icon"><#Icon iconify="ph:arrows-out-simple" class="size-5" /></span>
                <span class="composer-restore-icon"><#Icon iconify="ph:arrows-in-simple" class="size-5" /></span>
              </button>
              <button
                id="minimize_composer_button"
                phx-click={LiveHandler.minimize()}
                phx-target="#smart_input"
                type="button"
                aria-label={l("Minimise composer, keep draft")}
                title={l("Minimise composer, keep draft")}
                class="btn btn-sm btn-ghost btn-circle min-h-11 min-w-11 text-muted focus-ring"
              ><#Icon iconify="ph:minus" class="size-5" /></button>
            </div>
          </div>
          <div
            id="composer_policy_controls"
            role="group"
            aria-label={l("Audience and permissions")}
            class="w-full min-w-0 border-t border-base-content/10"
          >
            {#if e(@smart_input_opts, :create_object_type, nil) in ["message", :message]}
              <div
                class="flex items-center gap-2 px-4 py-3 text-sm text-warning"
                title={l(
                  "Messages on the fediverse are not currently end-to-end encrypted. Do not share any sensitive information."
                )}
              >
                <#Icon iconify="ph:lock-simple-open-fill" class="w-4 h-4" />
                <span class="text-sm">{l("Not encrypted")}</span>
              </div>
            {#elseif replying?(assigns) or group_context?(@context_group) or @showing_within != :thread_embed}
              {!-- Where it's posted on the left, who can see it on the right. In thread_embed the
                  boundary follows the parent thread, so personal posts get no policy row there. --}
              <div class="grid w-full min-w-0 grid-cols-1 sm:grid-cols-2">
                {#if replying?(assigns)}
                  <div
                    id="composer_reply_destination"
                    data-role="reply_destination"
                    class="flex min-h-12 min-w-0 items-center gap-2 px-4 py-2"
                  >
                    <span class="sr-only">{l("Reply in")}</span>
                    <span class="flex min-w-0 items-center gap-2 text-sm font-semibold">
                      <#Icon iconify="ph:chats" class="size-5 shrink-0 text-muted" />
                      <span class="break-words">
                        <span :if={e(@smart_input_opts, :reply_destination, :group_name, nil)}>{e(@smart_input_opts, :reply_destination, :group_name, nil)} /</span>
                        {e(@smart_input_opts, :reply_destination, :name, nil) || l("Original conversation")}
                      </span>
                    </span>
                  </div>
                {#else}
                  <StatefulComponent
                    module={maybe_component(Bonfire.UI.Boundaries.AudiencePickerLive, @__context__)}
                    id="composer_audience_picker"
                    mode={:destination}
                    to_boundaries={@to_boundaries}
                    context_group={@context_group}
                    event_target={@event_target}
                  />
                {/if}
                <div class="min-w-0 border-t border-base-content/10 sm:border-t-0 sm:border-l">
                  {#if replying?(assigns)}
                    <Bonfire.UI.Common.PolicyDropdownLive
                      id="composer_reply_visibility"
                      label={l("Visible to")}
                      icon="ph:shield-check-duotone"
                      selected_label={reply_audience_label(@to_boundaries)}
                      description={l("Replies use the original post's visibility by default. Narrower audiences still include the original author.")}
                      options={reply_audience_options(@smart_input_opts, @to_boundaries)}
                      event="Bonfire.UI.Common.SmartInput:select_reply_audience"
                      option_attr="data-reply-audience"
                      event_target={@event_target}
                    />
                  {#elseif group_context?(@context_group)}
                    <Bonfire.UI.Common.PolicyDropdownLive
                      id="composer_group_visibility"
                      label={l("Visible to")}
                      icon={group_audience_icon(@to_boundaries, @exclude_circles, @verb_permissions)}
                      selected_label={group_audience_label(@to_boundaries, @exclude_circles, @verb_permissions)}
                      status_opts={["data-role": "group-composer-audience"]}
                      description={l("Choose who can see this post within the group's rules.")}
                      options={group_audience_options(@context_group, @to_boundaries)}
                      event="Bonfire.UI.Common.SmartInput:select_group_audience"
                      option_attr="data-group-audience"
                      event_target={@event_target}
                    />
                  {#else}
                    <StatelessComponent
                      module={maybe_component(Bonfire.UI.Boundaries.SetBoundariesButtonLive, @__context__)}
                      to_boundaries={@to_boundaries}
                      boundary_preset={@boundary_preset}
                      preview_boundary_for_id={@preview_boundary_for_id}
                      preview_boundary_for_username={@preview_boundary_for_username}
                      preview_boundary_verbs={@preview_boundary_verbs}
                      to_circles={@to_circles}
                      exclude_circles={@exclude_circles}
                      verb_permissions={@verb_permissions}
                      setting_boundaries={:create_object}
                      context_id={@context_id}
                      context_group={@context_group}
                      event_target={@event_target}
                    />
                  {/if}
                </div>
              </div>
            {/if}
          </div>
          <div
            :if={not replying?(assigns) and e(@smart_input_opts, :create_object_type, nil) not in ["message", :message] and
              not is_nil(e(@context_group, :group_id, nil)) and e(@context_group, :topics, []) != []}
            id="composer_topic_controls"
            class="border-t border-base-content/10 px-2 py-1"
          >
            <Dropdown
              wrapper_opts={["data-boundary": "#composer_container"]}
              id="composer_destination"
              menu={false}
              close_on_select
              position="bottom-start"
              trigger_class="flex min-h-11 max-w-full items-center gap-2 rounded px-2 text-sm hover:bg-base-content/5 focus-ring"
              panel_class="!w-72 max-w-[calc(100vw-2rem)] !p-2 max-h-72 overflow-y-auto overscroll-contain"
              label={l("Choose an optional topic")}
            >
              <:trigger>
                <#Icon iconify="ph:chats-circle-duotone" class="size-4 shrink-0 text-primary" />
                <span class="text-muted">{l("Topic")}</span>
                <span class="min-w-0 break-words font-medium">{if @context_group.id == @context_group.group_id, do: l("Whole group"), else: @context_group.name}</span>
                <#Icon iconify="ph:caret-down" class="size-4 shrink-0 text-muted" />
              </:trigger>
              <button type="button" phx-click="Bonfire.UI.Common.SmartInput:pick_context"
                phx-value-id={@context_group.group_id} phx-target={@event_target || "#smart_input"}
                aria-pressed={"#{@context_group.id == @context_group.group_id}"}
                class="w-full min-h-11 rounded px-2 py-2 text-left hover:bg-base-200 aria-pressed:bg-primary/10 aria-pressed:text-primary focus-ring">
                {l("Whole group")}
              </button>
              {#for topic <- @context_group.topics}
                <button type="button" phx-click="Bonfire.UI.Common.SmartInput:pick_context"
                  phx-value-id={id(topic)} phx-target={@event_target || "#smart_input"}
                  aria-pressed={"#{@context_group.id == id(topic)}"}
                  class="w-full min-h-11 rounded px-2 py-2 text-left hover:bg-base-200 aria-pressed:bg-primary/10 aria-pressed:text-primary focus-ring">
                  {Bonfire.Classify.Web.Preview.CategoryLive.name(topic, l("Topic"))}
                </button>
              {/for}
            </Dropdown>
          </div>
        </header>

        {!-- TEMPORARY mock-up for #2352/#2303, not wired: remove once the design is decided. Behind the app-wide `:show_unimplemented` flag, which dev turns on.
             Commented out (not deleted) now that the composer implements this design; the component stays for reference.
        <Bonfire.UI.Common.ComposerHeaderMockupLive
          :if={show_unimplemented?() and @showing_within != :thread_embed and
            e(@smart_input_opts, :create_object_type, nil) not in ["message", :message]}
          context_group={@context_group}
        />
        --}

        <section :if={replying?(assigns)} id="reply_peek" hidden aria-label={l("Original post")}
          class="reply_in_composer shrink-0 max-h-40 overflow-y-auto overscroll-contain border-b border-base-content/10 bg-base-200/40 px-4 py-3">
              <StatelessComponent
                module={maybe_component(Bonfire.UI.Social.ActivityLive, @__context__)}
                activity_component_id={deterministic_dom_id(
                  __MODULE__,
                  id(@reply_to_id) || id(@object) || id(@activity),
                  e(@reply_to_id, nil)
                )}
                myself={nil}
                activity={@activity}
                cw={e(post_content(@object), :summary, nil)}
                object={@object || @reply_to_id}
                thread_mode={:nested}
                class={@replied_activity_class}
                hide_activity="subject"
                show_minimal_subject_and_note={Bonfire.UI.Social.ActivityLive.name_or_text(@object) || true}
                showing_within={:smart_input}
                activity_inception={@activity_inception}
                object_boundary={:skip_boundary_check}
              />
        </section>

        <div :if={is_map(@quoted_object)} id="quote_in_composer" class="">
          <div class="quote_in_composer relative max-h-[160px] overflow-y-auto overflow-x-hidden border-hair border-secondary bg-base-100">
            <header class="sticky top-0 rounded-t-box z-10 flex items-center justify-between gap-2 px-3 py-1.5 bg-base-200 backdrop-blur-sm border-b-hair border-secondary">
              <span class="inline-flex items-center gap-1.5 text-sm text-base-content">
                <#Icon iconify="ph:quotes-fill" class="w-3.5 h-3.5 text-primary" />
                {l("Quoting")}
              </span>

              <button
                type="button"
                phx-click="Bonfire.UI.Common.SmartInput:remove_quoted"
                phx-target="#smart_input"
                class="inline-flex cursor-pointer items-center gap-1 text-xs text-muted hover:text-base-content"
                title={l("Remove quote")}
                aria-label={l("Remove quote")}
              >
                <#Icon iconify="ph:x-bold" class="w-3.5 h-3.5" />
                <span class="hidden sm:inline">{l("Remove")}</span>
              </button>
            </header>

            <div class="p-2">
              <StatelessComponent
                module={maybe_component(Bonfire.UI.Social.ActivityLive, @__context__)}
                activity_component_id={deterministic_dom_id(__MODULE__, id(@quoted_object), :quoted)}
                myself={nil}
                activity={e(@quoted_object, :activity, nil)}
                object={@quoted_object}
                thread_mode={:nested}
                class="quoted_activity"
                show_minimal_subject_and_note={Bonfire.UI.Social.ActivityLive.name_or_text(@quoted_object) ||
                  true}
                hide_actions
                showing_within={:smart_input}
                object_boundary={:skip_boundary_check}
              />
            </div>
          </div>
        </div>

        <div
          :if={e(@activity, :subject, nil) != nil and
            !Bonfire.Social.is_local?(
              e(@activity, :subject, nil),
              false
            ) and
            !maybe_apply(Bonfire.Federate.ActivityPub, :federating?, current_user(@__context__),
              context: @__context__,
              fallback_return: false
            )}
          class="badge badge-warning m-2 mb-0 h-auto"
        >{l(
            "Warning: You are replying to a remote activity but federation is disabled. This means only users on your local instance will see your reply unless federation is later turned on."
          )}</div>

        {#case LiveHandler.active_smart_input_component(
            @smart_input_component,
            e(@smart_input_opts, :create_object_type, nil)
          )}
          {#match module}
            {#if function_exported?(module, :mount, 1)}
              <StatefulComponent
                id="smart_input_component"
                module={module}
                textarea_class={Surface.css_class(["editor_area textarea p-0 w-full rounded-none"])}
                {...assigns}
              />
            {#else}
              <StatelessComponent
                module={module}
                textarea_class={Surface.css_class(["editor_area textarea p-0 w-full rounded-none"])}
                {...assigns}
              />
            {/if}
        {/case}
      </div>
    </div>
  </div>
</div>

{#if current_user_id(@__context__) && show?(@selected_tab)}
  <div
    id="inline_composer_placeholder"
    class="p-card flex items-center gap-4 border-b-(length:--divider-width) border-divider bg-base-100"
  >
    <div class="shrink-0">
      <Bonfire.UI.Common.AvatarLive
        bg_class="rounded-full"
        title={e(current_user(@__context__), :profile, :name, "Anon")}
        wrapper_class="border-0 avatar !flex size-8.75"
        class="inline-block object-cover w-full rounded-full"
        src={Bonfire.Common.Media.avatar_url(current_user(@__context__)) ||
          @__context__[:current_user_avatar_url]}
        user_id={current_user_id(@__context__)}
        parent_id="inline_composer_placeholder"
        is_remote={false}
      />
    </div>
    <button
      type="button"
      id="inline_composer_placeholder_open"
      phx-click={Bonfire.UI.Common.SmartInput.LiveHandler.open(%JS{}, @smart_input_opts)}
      phx-target="#smart_input"
      class={
        "flex flex-1 min-w-0 items-center gap-3 text-left text-sm self-stretch min-h-11 cursor-pointer focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary",
        "rounded-box border border-divider bg-base-200 px-4 py-3 text-muted hover:bg-base-300 active:bg-base-300":
          e(@smart_input_opts, :context_id, nil),
        "text-muted": !e(@smart_input_opts, :context_id, nil)
      }
    >
      <span class="min-w-0 flex-1 break-words">{@prompt || l("Share something")}</span>
      <#Icon
        :if={e(@smart_input_opts, :context_id, nil)}
        iconify="ph:pencil-simple"
        class="size-5 shrink-0"
      />
    </button>
  </div>
{/if}

<div
  :if={Enum.count(@uploads.files.entries) > 0}
  id={deterministic_dom_id(__MODULE__, nil, "upload-preview", @parent_id)}
  class="uploads_preview group/uploads relative bg-fill shrink-0"
>
  {!-- Entries container: horizontal strip (collapsed) / vertical list (expanded) --}
  <div class={[
    "flex items-end gap-2 px-2 py-2 overflow-x-auto",
    "group-[.expanded]/uploads:flex-col group-[.expanded]/uploads:items-stretch",
    "group-[.expanded]/uploads:gap-0 group-[.expanded]/uploads:px-0",
    "group-[.expanded]/uploads:pt-10 group-[.expanded]/uploads:pb-0",
    "group-[.expanded]/uploads:max-h-[280px] group-[.expanded]/uploads:overflow-y-auto",
    # room for an image shown at full width while its alt text is written (see the thumbnail below)
    "group-[.expanded]/uploads:has-[textarea:focus]:max-h-[560px]",
    "group-[.expanded]/uploads:overflow-x-hidden",
    # collapsed: the newest upload wraps to its own row, with its alt text (see the entries below)
    "group-[:not(.expanded)]/uploads:flex-wrap"
  ]}>
    {#for entry <- @uploads.files.entries}
      {!-- collapsed, the newest upload shows its alt text and actions without Edit, on a row of its own, until its Done button adds `alt_done` --}
      <div
        id={deterministic_dom_id(__MODULE__, entry.ref, "upload-entry", @parent_id)}
        data-role="upload_entry"
        data-ref={entry.ref}
        class={[
          "group-[:not(.expanded)]/uploads:[&:last-child:not(.alt_done)]:basis-full group-[:not(.expanded)]/uploads:[&:last-child:not(.alt_done)]:flex-row",
          "group-[:not(.expanded)]/uploads:[&:last-child:not(.alt_done)]:items-start group-[:not(.expanded)]/uploads:[&:last-child:not(.alt_done)]:gap-3",
          # room for the Edit button, at the top right
          "group-[:not(.expanded)]/uploads:[&:last-child:not(.alt_done)]:pr-20",
          "flex flex-col items-center shrink-0 group group/entry relative",
          "group-[.expanded]/uploads:flex-row group-[.expanded]/uploads:gap-3",
          "group-[.expanded]/uploads:items-start group-[.expanded]/uploads:p-2.5",
          "group-[.expanded]/uploads:border-b group-[.expanded]/uploads:border-divider",
          # an image goes above its alt text while that is written
          "group-[.expanded]/uploads:has-[textarea:focus]:flex-col group-[.expanded]/uploads:has-[textarea:focus]:items-stretch":
            String.starts_with?(entry.client_type, "image"),
          "group-[:not(.expanded)]/uploads:[&:last-child:not(.alt_done)]:has-[textarea:focus]:flex-col group-[:not(.expanded)]/uploads:[&:last-child:not(.alt_done)]:has-[textarea:focus]:items-stretch":
            String.starts_with?(entry.client_type, "image")
        ]}
      >
        {!-- Thumbnail (rendered once — same in both modes) --}
        {!-- an image is shown whole, at full width, while its alt text is written, so the description can follow what it shows --}
        <figure class={[
          "size-16 rounded-box overflow-hidden shrink-0 bg-fill",
          "group-has-[textarea:focus]/entry:w-full group-has-[textarea:focus]/entry:h-auto":
            String.starts_with?(entry.client_type, "image")
        ]}>
          {#if String.starts_with?(entry.client_type, "image")}
            <Phoenix.Component.live_img_preview
              class="size-16 object-cover rounded-box group-has-[textarea:focus]/entry:w-full group-has-[textarea:focus]/entry:h-auto group-has-[textarea:focus]/entry:max-h-100 group-has-[textarea:focus]/entry:object-contain"
              entry={entry}
            />
          {#elseif String.contains?(entry.client_type, "pdf")}
            <div class="size-16 flex items-center justify-center">
              <#Icon iconify="bxs:file-pdf" class="size-7 text-subtle" />
            </div>
          {#elseif String.starts_with?(entry.client_type, "video")}
            <div class="size-16 flex items-center justify-center">
              <#Icon iconify="majesticons:video" class="size-7 text-subtle" />
            </div>
          {#elseif String.starts_with?(entry.client_type, "audio")}
            <div class="size-16 flex items-center justify-center">
              <#Icon iconify="lucide:audio-lines" class="size-7 text-subtle" />
            </div>
          {#else}
            <div class="size-16 flex items-center justify-center">
              <#Icon iconify="carbon:document" class="size-7 text-subtle" />
            </div>
          {/if}
        </figure>
        {!-- files upload on send (auto_upload: false) --}
        <progress
          :if={entry.progress > 0 and entry.progress < 100}
          class="progress progress-primary w-16 h-1 mt-1"
          value={entry.progress}
          max="100"
          aria-label={l("Uploading %{name}", name: entry.client_name)}
        />

        {!-- Details wrapper: transparent in collapsed (contents), flex column in expanded --}
        <div class={[
          "contents",
          "group-[.expanded]/uploads:flex group-[.expanded]/uploads:flex-col",
          "group-[.expanded]/uploads:gap-1.5 group-[.expanded]/uploads:flex-1",
          "group-[.expanded]/uploads:min-w-0"
        ]}>
          {!-- Filename (visible in both modes, styled differently) --}
          <span
            data-role="upload_filename"
            class={[
              "text-xs truncate max-w-16 text-muted mt-0.5",
              "group-[.expanded]/uploads:text-xs group-[.expanded]/uploads:max-w-none",
              "group-[.expanded]/uploads:text-muted group-[.expanded]/uploads:mt-0",
              "group-[:not(.expanded)]/uploads:group-[:last-child:not(.alt_done)]/entry:hidden"
            ]}
          >{entry.client_name}</span>

          {!-- Collapsed: compact error indicators --}
          {#for _err <- upload_errors(@uploads.files, entry)}
            <span class="text-xs text-error group-[.expanded]/uploads:hidden">!</span>
          {/for}

          {!-- Expanded: metadata editing (alt text, actions) --}
          <div class={[
            "hidden group-[.expanded]/uploads:flex flex-col gap-1.5",
            "group-[:not(.expanded)]/uploads:group-[:last-child:not(.alt_done)]/entry:flex group-[:not(.expanded)]/uploads:group-[:last-child:not(.alt_done)]/entry:flex-1 group-[:not(.expanded)]/uploads:group-[:last-child:not(.alt_done)]/entry:min-w-0"
          ]}>
            {#for err <- upload_errors(@uploads.files, entry)}
              <p class="text-xs text-error">{error_to_string(err)} {l("Please remove it before continuing.")}</p>
            {#else}
              <textarea
                id={deterministic_dom_id(__MODULE__, entry.ref, "upload_description", @parent_id)}
                name={"upload_metadata[#{entry.ref}][alt]"}
                phx-update="ignore"
                placeholder={l("Describe this file for accessibility")}
                class="textarea textarea-sm resize-none w-full text-sm bg-base-100/50"
                rows="2"
                style="field-sizing: content; min-height: 2.5rem; max-height: 5rem;"
              />
            {/for}

            <div class="flex items-center gap-1.5 flex-wrap">
              {#if String.starts_with?(entry.client_type, "image")}
                <input
                  type="hidden"
                  name={"upload_metadata[#{entry.ref}][primary_image]"}
                  value={if @selected_cover == entry.ref, do: "true", else: ""}
                  id={deterministic_dom_id(__MODULE__, entry.ref, "primary_image", @parent_id)}
                />
                <button
                  type="button"
                  class={[
                    "btn btn-sm gap-1 shrink-0",
                    "btn-primary": @selected_cover == entry.ref,
                    "btn-ghost btn-soft": @selected_cover != entry.ref
                  ]}
                  phx-click="Bonfire.UI.Common.SmartInput:toggle-cover-image"
                  phx-target={@event_target}
                  phx-value-ref={entry.ref}
                >
                  <#Icon iconify="ph:image-fill" class="size-3.5" />
                  <span class="text-xs">{if @selected_cover == entry.ref, do: l("Cover image"), else: l("Set as cover")}</span>
                </button>
              {/if}
              {!-- places the file in the text, where the cursor is, as `upload:<ref>` until publishing gives it a URL (see `Bonfire.Files.InlineMedia.swap_upload_refs/2`) --}
              <button
                type="button"
                data-role="insert_in_text"
                class="btn btn-ghost btn-soft btn-sm gap-1 shrink-0"
                phx-click={JS.dispatch("bonfire:insert_at_cursor",
                  # on the button itself: it goes to the plain field last written in (eg. a poll's question or option), else to the text editor (see `milkdown.hooks.js`)
                  detail: %{text: "![](upload:#{entry.ref})", markdown: true}
                )}
              >
                <span class="text-xs">{l("Insert in text")}</span>
              </button>
              <button
                type="button"
                class="btn btn-ghost btn-soft btn-sm gap-1 shrink-0 hover:btn-error transition-colors"
                phx-click="Bonfire.UI.Common.SmartInput:cancel-upload"
                phx-target={@event_target}
                phx-value-ref={entry.ref}
              >
                <#Icon iconify="ph:trash-fill" class="size-3.5" />
                <span class="text-xs">{l("Remove")}</span>
              </button>
            </div>
          </div>
        </div>

        {!-- Collapsed only: hover remove button overlaid on thumbnail --}
        <button
          type="button"
          class="absolute -top-1 -right-1 btn btn-circle btn-sm bg-base-300/80 border-0 opacity-0 group-hover:opacity-100 transition-opacity z-10 group-[.expanded]/uploads:hidden"
          phx-click="Bonfire.UI.Common.SmartInput:cancel-upload"
          phx-target={@event_target}
          phx-value-ref={entry.ref}
          aria-label={l("Remove")}
        >
          <#Icon iconify="ph:x" class="size-3" />
        </button>

        {!-- Collapsed only: cover badge --}
        {#if String.starts_with?(entry.client_type, "image") and @selected_cover == entry.ref}
          <div class="absolute top-0.5 left-0.5 size-4 rounded-full bg-primary flex items-center justify-center z-10 group-[.expanded]/uploads:hidden">
            <#Icon iconify="ph:asterisk-fill" class="size-2.5 text-primary-content" />
          </div>
        {/if}
      </div>
    {/for}
  </div>

  {!-- Done, in the toggle's place while the newest upload shows its alt text on its own row (collapsed): puts it back in the strip of thumbnails, which brings the toggle back --}
  <button
    type="button"
    data-role="alt_done"
    class="hidden btn btn-primary btn-sm absolute top-3 right-3 z-10 gap-1 group-[:not(.expanded):has([data-role=upload_entry]:last-child:not(.alt_done))]/uploads:flex"
    phx-click={JS.add_class("alt_done",
      to:
        "#" <>
          deterministic_dom_id(__MODULE__, nil, "upload-preview", @parent_id) <>
          " [data-role=upload_entry]:last-child"
    )}
  >
    <#Icon iconify="ph:check-bold" class="size-4" />
    {l("Done")}
  </button>

  {!-- Toggle button: Edit / Collapse. Either also closes the newest upload's own row, so a collapse doesn't reopen it --}
  <button
    type="button"
    data-role="upload_toggle"
    class="btn btn-ghost btn-soft btn-sm absolute top-3 right-3 z-10 group-[:not(.expanded):has([data-role=upload_entry]:last-child:not(.alt_done))]/uploads:hidden"
    phx-click={JS.toggle_class("expanded",
      to: "#" <> deterministic_dom_id(__MODULE__, nil, "upload-preview", @parent_id)
    )
    |> JS.add_class("alt_done",
      to:
        "#" <>
          deterministic_dom_id(__MODULE__, nil, "upload-preview", @parent_id) <>
          " [data-role=upload_entry]:last-child"
    )}
  >
    <span class="flex items-center gap-1 group-[.expanded]/uploads:hidden">
      <#Icon iconify="ph:pencil-simple-line-fill" class="size-4" />
      {l("Edit")}
    </span>
    <span class="hidden items-center gap-1 group-[.expanded]/uploads:flex">
      {l("Collapse")}
      <#Icon iconify="carbon:chevron-down" class="size-4" />
    </span>
  </button>

  {!-- Global upload errors --}
  {#for err <- upload_errors(@uploads.files)}
    <p class="alert alert-warning mx-2 mb-2 p-2 text-xs">{error_to_string(err)}</p>
  {/for}
</div>

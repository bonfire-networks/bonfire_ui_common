{!-- width and the composer's narrowing are in app.css, beside the composer's own rule --}
<aside
  id="media_picker"
  data-id="media_picker"
  aria-label={l("Your media")}
  class="fixed inset-0 z-popover flex flex-col bg-base-100 transition-transform duration-300 ease-out starting:translate-x-full motion-reduce:transition-none"
  phx-remove={JS.hide(
    time: 200,
    transition: {"transition-transform duration-200 ease-in motion-reduce:transition-none", "translate-x-0", "translate-x-full"}
  )}
>
  <div class="flex items-center gap-1 pl-4 pr-2 pt-2">
    <h2 class="type-heading flex-1">{l("Your media")}</h2>
    <button
      type="button"
      id="media_picker_close"
      class="btn btn-ghost btn-circle size-11 text-muted"
      phx-click="Bonfire.UI.Common.SmartInput:toggle-media-picker"
      phx-target={@event_target || "#smart_input"}
      phx-value-open="false"
      aria-label={l("Close")}
    >
      <#Icon iconify="ph:x" class="size-5" />
    </button>
  </div>

  {!-- the feed holds the filters, so which pill is pressed is kept in the browser --}
  <div
    role="group"
    aria-label={l("Media type")}
    class="flex gap-1 overflow-x-auto px-4 pt-1 pb-3 [scrollbar-width:none]"
  >
    <button
      :for={{type, label} <- media_type_pills()}
      type="button"
      data-role="media_type_pill"
      data-type={type}
      aria-pressed={to_string(type == "attachment")}
      class="btn btn-sm btn-ghost rounded-selector shrink-0 font-normal text-muted aria-pressed:bg-fill-strong aria-pressed:text-base-content touch-target-expanded"
      phx-click={JS.set_attribute({"aria-pressed", "false"}, to: "#media_picker [data-role=media_type_pill]")
      |> JS.set_attribute({"aria-pressed", "true"})
      |> JS.push("set_filter",
        value: %{toggle: "media_types", toggle_type: type, toggle_value: "true", tab_mode: "true"},
        target: "#" <> feed_id()
      )}
    >
      <span class="touch-target-hit-area" aria-hidden="true" />
      {label}
    </button>
  </div>

  <div class="flex-1 overflow-y-auto">
    <StatefulComponent
      module={maybe_component(Bonfire.UI.Social.FeedLive, @__context__)}
      id={feed_id()}
      feed_name={:my_media}
      feed_filters={feed_filters(@__context__)}
      showing_within={:media_picker}
      custom_preview={Bonfire.UI.Social.Activity.MediaTileLive}
      list_class="grid grid-cols-[repeat(auto-fill,minmax(10rem,1fr))] gap-2 px-4 pb-4"
      hide_filters
    >
      {!-- the tile lays them over itself (`MediaTileLive`); a tile dragged into the text clicks `pick_insert` --}
      <:activity_extra_actions :let={object: media}>
        <button
          type="button"
          data-role="pick_insert"
          class="btn btn-primary btn-sm min-w-0 px-2 whitespace-nowrap border-none touch-target-expanded"
          phx-click={JS.dispatch("bonfire:insert_at_cursor",
            detail: %{text: Bonfire.UI.Common.UploadPreviewsLive.insert_text(media), markdown: true}
          )
          |> JS.push("Bonfire.UI.Common.SmartInput:pick-media",
            value: %{
              id: id(media),
              picked: Bonfire.UI.Common.UploadPreviewsLive.picked_ids(e(@smart_input_opts, :picked_media, nil))
            },
            target: @event_target || "#smart_input"
          )}
        ><span class="touch-target-hit-area" aria-hidden="true" />{l("Insert")}</button>
        <button
          type="button"
          data-role="pick_attach"
          class="btn btn-sm min-w-0 px-2 whitespace-nowrap border-none bg-base-100 text-base-content touch-target-expanded"
          phx-click={JS.push("Bonfire.UI.Common.SmartInput:pick-media",
            value: %{
              id: id(media),
              picked: Bonfire.UI.Common.UploadPreviewsLive.picked_ids(e(@smart_input_opts, :picked_media, nil))
            },
            target: @event_target || "#smart_input"
          )}
        ><span class="touch-target-hit-area" aria-hidden="true" />{l("Attach")}</button>
      </:activity_extra_actions>
    </StatefulComponent>
  </div>
</aside>

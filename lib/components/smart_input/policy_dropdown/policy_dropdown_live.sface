<Dropdown
  wrapper_opts={["data-boundary": "#composer_container"]}
  id={@id}
  menu={false}
  close_on_select
  position="bottom-start"
  wrapper_class="min-w-0 max-w-full"
  trigger_class={"flex h-8 min-w-0 max-w-full items-center gap-1.5 rounded-full border px-3 text-left text-sm font-medium focus-ring " <> if(@emphasis, do: "border-primary/30 bg-primary/10 text-primary hover:bg-primary/15", else: "border-divider bg-base-100 hover:bg-base-200")}
  panel_class="!w-72 max-w-[calc(100vw-2rem)] !p-2"
  label={@label}
>
  <:trigger>
    <span class="sr-only">{@label}</span>
    <span class="flex min-w-0 items-center gap-1.5" role="status" {...@status_opts}>
      <Iconify.iconify icon={@icon} class="size-4 shrink-0 opacity-70" />
      <span class="min-w-0 truncate">{@selected_label}</span>
    </span>
  </:trigger>
  <p :if={@description} class="px-2 py-2 text-sm text-muted">{@description}</p>
  <button
    :for={option <- @options}
    type="button"
    {...%{@option_attr => option.id}}
    phx-click={@event}
    phx-value-id={option.id}
    phx-target={@event_target || "#smart_input"}
    aria-pressed={"#{option.selected?}"}
    class="group flex w-full min-h-11 sm:min-h-10 items-center gap-2 rounded-selector px-2 py-1.5 text-sm text-left hover:bg-base-200 aria-pressed:bg-primary/10 focus-ring"
  >
    <Iconify.iconify :if={option[:icon]} icon={option.icon} class="size-5 shrink-0 text-muted" />
    <span class="grow">{option.label}</span>
    <#Icon iconify="ph:check" class="size-4 invisible group-aria-pressed:visible" />
  </button>
</Dropdown>

<div class="flex flex-col flex-1 h-full bg-base-100 rounded-b-box min-h-0">
  <div class="flex-1 h-full grow min-h-0" id="compose_content_wrapper">
    <div class="relative !flex flex-col flex-1 h-full min-h-0">
      {!-- here was old/loader.svg --}
      <div
        id="composer_wrapper"
        class={
          "flex-1 flex flex-col min-h-0",
          "[&_.milkdown-editor]:px-4": @showing_within == :thread_embed,
          "[&_.milkdown-editor]:px-3 sm:[&_.milkdown-editor]:px-4": @showing_within != :thread_embed
        }
      >
        <div class="h-full flex flex-col flex-1 grow relative min-h-0">
          <div class="flex-1 min-h-0 overflow-y-auto overscroll-y-contain flex flex-col">
            {!-- Title: shown expanded when `@title_visible`, or behind a toggle when `@title_toggle` (per the `enable_fields` config). --}
            <div
              :if={@title_visible or @title_toggle}
              class={[hidden: !@title_visible]}
              id="smart_input_post_title"
            >
              {!-- phx-update="ignore" needs its own id (preserves the typed title across re-renders while the outer div above stays reactive to show/hide) --}
              <div
                phx-update="ignore"
                id="smart_input_post_title_value"
                class={
                  "py-1",
                  "px-4": @showing_within == :thread_embed,
                  "px-3 sm:px-4": @showing_within != :thread_embed
                }
              >
                <div class="flex items-center gap-2 rounded-box border border-divider bg-base-100 py-1.5 pl-3 pr-3 focus-within:border-base-content/30">
                  <label
                    for="composer_post_title"
                    class="flex shrink-0 items-center gap-1.5 text-sm font-medium leading-7 text-muted"
                  >
                    <#Icon iconify="ph:text-h" class="size-4" />
                    {l("Title")}
                  </label>
                  <input
                    id="composer_post_title"
                    autocomplete="off"
                    value={@smart_input_opts[:title]}
                    name="post[post_content][name]"
                    class="min-w-0 flex-1 border-0 bg-transparent p-0 text-sm font-medium leading-7 text-base-content placeholder:font-normal placeholder:text-muted focus:outline-none focus-visible:outline-none"
                    placeholder={l("Optional")}
                  />
                </div>
              </div>
            </div>
            {!-- The `summary` field doubles as the article summary (shown by default for articles) and, when `sensitive` is toggled on, as the content warning. --}
            <div
              class={[
                "py-1",
                "px-4": @showing_within == :thread_embed,
                "px-3 sm:px-4": @showing_within != :thread_embed,
                hidden: !@summary_field_shown
              ]}
              id="smart_input_summary"
            >
              <div class={
                "flex items-start gap-2 rounded-box border py-1.5 pl-3 pr-1.5",
                "border-warning/30 bg-warning/10 focus-within:border-warning/70": @show_sensitive || @show_cw,
                "border-divider bg-base-100 focus-within:border-base-content/30": !(@show_sensitive || @show_cw)
              }>
                {!-- Reactive role prefix: the textarea is `phx-update="ignore"` (to keep typed content), so a placeholder there would be frozen; this label flips between Content warning and Summary instead --}
                <span
                  :if={@summary_field_shown}
                  class={
                    "flex shrink-0 items-center gap-1.5 text-sm font-medium leading-7",
                    "text-warning": @show_sensitive || @show_cw,
                    "text-muted": !(@show_sensitive || @show_cw)
                  }
                >
                  <#Icon
                    iconify={if @show_sensitive || @show_cw, do: "ph:warning-circle", else: "ph:text-align-left"}
                    class="size-4"
                  />
                  {if @show_sensitive || @show_cw, do: l("Content warning"), else: l("Summary")}
                </span>
                <div phx-update="ignore" id="smart_input_summary_value" class="flex-1 min-w-0">
                  <textarea
                    name="post[post_content][summary]"
                    aria-label={l("Content warning or summary")}
                    placeholder={l("What people see first")}
                    class="block w-full m-0 p-0 !outline-0 !outline-none bg-transparent border-0 resize-none text-sm leading-7 text-base-content placeholder:text-muted focus:ring-0 focus:outline-none"
                    rows="1"
                    style="field-sizing: content; min-height: 0; max-height: 6rem;"
                  >{e(@smart_input_opts, :cw, nil)}</textarea>
                </div>
                <button
                  type="button"
                  phx-click="Bonfire.UI.Common.SmartInput:clear_sensitive"
                  phx-target={@event_target || "#smart_input"}
                  class="grid size-7 shrink-0 place-items-center rounded-full text-muted hover:bg-base-200 hover:text-base-content focus-ring"
                  title={if @show_sensitive || @show_cw, do: l("Remove content warning"), else: l("Remove summary")}
                  aria-label={if @show_sensitive || @show_cw, do: l("Remove content warning"), else: l("Remove summary")}
                >
                  <#Icon iconify="ph:x" class="size-4" />
                </button>
              </div>
            </div>

            <div
              :if={e(@smart_input_opts, :create_object_type, nil) in [:post, "post", nil]}
              class="relative p-2 bg-base-100 hidden"
              id="smart_input_scheduled_at"
              phx-update="ignore"
            >
              <label class="input w-full">
                <span class="text-xs uppercase text-muted">{l("Schedule")}</span>
                <input
                  type="datetime-local"
                  name="scheduled_at"
                  class="grow block w-full"
                  value={e(@smart_input_opts, :scheduled_at, nil)}
                  placeholder={l("Schedule for date")}
                />
                <!-- <span class="badge badge-neutral badge-xs">Optional</span> -->
              </label>
            </div>

            {!-- SLOT WITH EXTRA FORM INPUTS DEPENDING ON THE TYPE OF OBJECT TO CREATE --}
            <#slot {@default} />
          </div>

          {!-- UPLOADS PREVIEWS - outside the editor scroll context --}
          <Bonfire.UI.Common.UploadPreviewsLive
            selected_cover={@selected_cover}
            event_target={@event_target || "#smart_input"}
            :if={@uploads != false}
            uploads={@uploads}
          />
        </div>
      </div>

      <div class="z-50 shrink-0 bg-base-100">
        <div class="pb-safe">
          <div class={
            "flex flex-row items-center gap-1 lg:rounded-b-box",
            "p-2 md:px-3": @showing_within == :thread_embed,
            "py-2 pr-3 pl-1.5 sm:pl-2.5": @showing_within != :thread_embed
          }>
            <div>
              <div :if={@showing_within != :thread_embed} class="flex flex-wrap items-center gap-2">
                <Bonfire.UI.Common.UploadButtonLive
                  :if={@uploads != false && e(@smart_input_opts, :create_object_type, nil) not in [:message, "message"]}
                  uploads={@uploads}
                  max_uploads={Bonfire.Common.Settings.get(
                    [Bonfire.UI.Common.SmartInputLive, :max_uploads],
                    :instance,
                    current_user: current_user(@__context__),
                    name: l("Maximum Uploads"),
                    description: l("Maximum number of files that can be uploaded at once.")
                  )}
                />

                <!-- data-close-on-inside-click="true" -->
                {!-- embed: position:fixed + no-flip escapes the composer's
                   overflow-hidden ancestors so the panel isn't clipped --}
                <div
                  phx-hook="Tooltip"
                  data-position={if @showing_within == :thread_embed, do: "bottom", else: "top"}
                  data-no-flip={if @showing_within == :thread_embed, do: "true"}
                  data-strategy={if @showing_within == :thread_embed, do: "fixed"}
                  phx-update="ignore"
                  id="emoji_picker_in_composer"
                  data-trigger="click"
                >
                  <button
                    title={l("Insert emoji")}
                    type="button"
                    class="tooltip-button emoji-button btn btn-ghost btn-sm btn-circle"
                  >
                    <#Icon iconify="ph:smiley-wink-fill" class="size-5 text-muted" />
                  </button>
                  <div
                    id="emoji-picker-in-composer"
                    class={[
                      "emoji-picker-in-composer w-60 tooltip right-0 hidden",
                      "absolute bottom-full z-50 mb-2": @showing_within != :thread_embed,
                      "fixed z-[100]": @showing_within == :thread_embed
                    ]}
                    data-emojis={@custom_emojis}
                  />
                </div>

                <div :if={@sensitive_toggle} class="relative z-30 flex items-center" id="sensitive_btn">
                  <button
                    title={l("Content warning")}
                    aria-label={l("Content warning")}
                    aria-pressed={to_string(@show_sensitive)}
                    type="button"
                    phx-click="Bonfire.UI.Common.SmartInput:toggle_sensitive"
                    phx-target={@event_target || "#smart_input"}
                    class={[
                      "relative btn btn-ghost btn-sm btn-circle text-muted",
                      "bg-warning !text-warning-content": @show_sensitive
                    ]}
                  >
                    {!-- icon-only, like the other tools (aria-label above) --}
                    <#Icon iconify="ph:warning-circle" class="size-5" />
                  </button>
                  <input type="hidden" name="sensitive" value={to_string(@show_sensitive)}>
                </div>

                <Dropdown
                  wrapper_opts={["data-boundary": "#composer_container"]}
                  :if={@showing_within != :thread_embed}
                  id="smart_input_more_options"
                  position="top"
                  trigger_class="emoji-button btn btn-ghost btn-sm btn-circle"
                  label={l("More options")}
                >
                  <:trigger>
                    <#Icon iconify="ph:dots-three-bold" class="size-5 text-muted" />
                  </:trigger>

                  {!-- Title toggle button — only for types configured with `toggle: true`. --}
                  <li :if={@title_toggle and e(@smart_input_opts, :create_object_type, nil) not in [:message, "message"]}>
                    <button
                      type="button"
                      id="title_btn"
                      phx-click={JS.toggle(to: "#smart_input_post_title")
                      |> JS.focus(to: "#smart_input_post_title input")}
                      class="title-button"
                    >
                      <#Icon iconify="ph:text-h-one-fill" class="size-5 text-muted" />
                      <span class="text-sm">{l("Add a Title")}</span>
                    </button>
                  </li>

                  <li :if={@summary_toggle and !@summary_field_shown}>
                    <button
                      type="button"
                      id="summary_btn"
                      phx-click="Bonfire.UI.Common.SmartInput:toggle_summary"
                      phx-target={@event_target || "#smart_input"}
                      class="title-button"
                    >
                      <#Icon iconify="ph:text-align-left" class="size-5 text-muted" />
                      <span class="text-sm">{l("Add a summary")}</span>
                    </button>
                  </li>

                  <li :if={is_nil(@reply_to_id) and
                    e(@smart_input_opts, :create_object_type, nil) not in [:message, "message"]}>
                    <button
                      type="button"
                      id="scheduled_at_btn"
                      phx-click={JS.toggle(to: "#smart_input_scheduled_at")
                      |> JS.focus(to: "#smart_input_scheduled_at input[type='date']")}
                      class="title-button"
                    >
                      <#Icon iconify="ph:calendar-fill" class="size-5 text-muted" />
                      <span class="text-sm">{l("Schedule post")}</span>
                    </button>
                  </li>
                </Dropdown>
              </div>
            </div>
            <div id="composer_publish_controls" class="flex flex-1 items-center gap-2">
              <span class="flex-1" />
              {#if @showing_within != :thread_embed}
                <!-- Language selection dropdown -->
                {#case to_string(
                    e(@__context__, :locale, nil) ||
                      Config.get(
                        [Bonfire.Common.Localise.Cldr, :default_locale],
                        "en"
                      )
                  )}
                  {#match locale}
                    <Dropdown
                      wrapper_opts={["data-boundary": "#composer_container"]}
                      id="language_dropdown"
                      position="top"
                      trigger_class="lang-button btn btn-ghost btn-sm !px-2"
                      panel_class="flex-col flex-nowrap max-h-60 overflow-y-auto"
                      label={l("Set post language")}
                      trigger_opts={[title: l("Set post language")]}
                    >
                      <:trigger>
                        <span
                          id="selected_language_label"
                          phx-update="ignore"
                          class="text-xs font-medium text-muted uppercase"
                        >{locale}</span>
                      </:trigger>

                      {#for {lang, name} <-
                          Bonfire.Common.Localise.locales_with_names(
                            @__context__[:locales] ||
                              Bonfire.UI.Common.LivePlugs.Locale.preferred_locales(current_user(@__context__)) ||
                              Bonfire.Common.Localise.known_locales()
                          )}
                        <li>
                          <label
                            class="flex items-center gap-2 cursor-pointer"
                            onclick={"document.getElementById('selected_language_label').innerText='#{to_string(lang)}'"}
                          >
                            <input
                              type="radio"
                              name="language"
                              value={to_string(lang)}
                              checked={(e(@smart_input_opts, :selected_language, nil) || locale) == to_string(lang)}
                              class="radio radio-sm"
                            />
                            {name}
                          </label>
                        </li>
                      {/for}
                      <li :if={current_user_id(@__context__)} class="border-t border-divider mt-1 pt-1">
                        <a
                          href="/settings/user/preferences/behaviours"
                          target="_blank"
                          rel="noopener"
                          class="flex items-center gap-2 text-xs text-muted hover:text-primary"
                          title={l("Open language preferences in a new tab")}
                        >
                          <#Icon iconify="ph:gear-fill" class="size-4" />
                          {l("Manage languages")}
                        </a>
                      </li>
                    </Dropdown>
                {/case}
              {/if}

              <button
                :if={@showing_within == :thread_embed && @reply_to_id && @context_id &&
                  to_string(@reply_to_id) != to_string(@context_id)}
                type="button"
                id={"inline_cancel_reply_#{@composer_dom_id || id(@reply_to_id) || "reply"}"}
                class="btn btn-ghost btn-sm whitespace-nowrap"
                phx-click="reset_reply_to"
                title={l("Cancel reply")}
                aria-label={l("Cancel reply")}
              >
                {l("Cancel")}
              </button>

              <button
                type="submit"
                id="submit_btn"
                x-on:click="$dispatch('submit')"
                phx-disable-with
                class="btn btn-primary btn-sm"
                disabled={@smart_input_opts[:input_status] != :draft}
              >
                {!-- <#Icon iconify="mdi:email-fast-outline" class="size-4" /> --}
                <!-- <#Icon iconify="lucide:arrow-up" class="size-4" /> -->
                {#case e(@smart_input_opts, :create_object_type, nil)}
                  {#match type when type in [:message, "message"]}
                    {if @smart_input_opts[:input_status] == :submit, do: l("Sending..."), else: l("Send")}
                  {#match _ when not is_nil(@reply_to_id) and @reply_to_id != ""}
                    {!-- A reply: the verb is "Reply", not "Post" (matches the
                         "Replying to …" banner and avoids clashing with the
                         create-type "Post" label). --}
                    {if @smart_input_opts[:input_status] == :submit,
                      do: l("Replying..."),
                      else: lc("verb: action", "Reply", [], :bonfire_social)}
                  {#match _}
                    {if @smart_input_opts[:input_status] == :submit,
                      do: l("Posting..."),
                      else: lc("verb: action", "Post", [], :bonfire_posts)}
                {/case}
              </button>
            </div>
          </div>
        </div>

        <input type="hidden" name="thread_id" value={e(@smart_input_opts, :id, nil)}>

        <input type="hidden" name="reply_to[reply_to_id]" value={@reply_to_id}>
        <input type="hidden" name="reply_to[thread_id]" value={@context_id}>
        {!-- FIXME: should not thread using context like a group or topic --}
        <input type="hidden" name="context_id" value={@context_id}>
        <input
          type="hidden"
          name={:create_object_type}
          value={e(@smart_input_opts, :create_object_type, nil)}
        />

        <StatelessComponent
          module={maybe_component(Bonfire.UI.Boundaries.BoundariesSelectionLive, @__context__)}
          to_boundaries={@to_boundaries}
          to_circles={@to_circles}
          exclude_circles={@exclude_circles}
          context_id={@context_id}
        />

        <label data-role="mentions">
          <input :for={mention <- e(@mentions, [])} type="hidden" name="mentions[]" value={mention}>
        </label>

        <label data-role="include_circles">
          <input
            :for={{circle, role} <- e(@to_circles, []) |> debug("to_circles_with_roles")}
            type="hidden"
            data-role="circle-enum"
            name={"to_circles[#{id(circle)}]"}
            value={role}
          />
        </label>
        <label data-role="circles-binary">
          <input
            :for={value when is_binary(value) <- @to_circles || []}
            type="hidden"
            data-role="circle-binary"
            name="to_circles[]"
            value={value}
          />
        </label>

        <label data-role="verb_permissions">
          {!-- <input type="hidden" name="verb_permissions_json" value={Jason.encode!(@verb_permissions) |> debug("json")}> --}
          {#for {verb, permissions} <- e(@verb_permissions, [])}
            <input
              :for={{to, value} <- permissions || []}
              type="hidden"
              data-role="circle-binary"
              name={"verb_permissions[#{verb}][#{to}]"}
              value={value}
            />
          {/for}
        </label>
      </div>
    </div>
  </div>
</div>

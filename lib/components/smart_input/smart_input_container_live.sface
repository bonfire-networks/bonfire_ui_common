<div class="flex-1">
  <div>
    <div class="sticky top-0 flex items-center flex-1 w-full">
      <Bonfire.UI.Common.SmartInputButtonLive
        id="main_smart_input_button"
        showing_within={:smart_input}
        as_icon={e(@as_icon, false)}
        without_icon
        smart_input_opts={@smart_input_opts}
        prompt={e(@smart_input_opts, :prompt, l("Compose"))}
        class={e(
          @composer_class,
          "!p-0 lg:!p-inherit flex size-15 lg:!min-h-auto lg:!px-[1rem] lg:!h-auto lg:!w-full btn btn-primary flex items-center gap-2 place-content-center normal-case"
        )}
      />

      {!--
      Note: not including these props because we want the main button to open ther post composer by default, or whatever other type is already selected (until the smart input is reset)
      smart_input_component={@smart_input_component}
      create_object_type={@create_object_type} --}
    </div>

    {#if not is_nil(current_user_id(@__context__))}
      {!-- In test env, skip the portal wrapper so PhoenixTest can interact with the composer
           (portals render inside <template> which is inert in tests without JS) --}
      {#if Bonfire.Common.Config.env() == :test}
        <div
          id="smart_input_container"
          data-hidden={e(@smart_input_opts, :open, nil) != true}
          data-draft={if e(@smart_input_opts, :input_status, nil) == :draft, do: "true"}
          data-focused={Settings.get([Bonfire.UI.Common.SmartInputContainerLive, :show_focused], false, @__context__)}
          class={
            "w-full md:h-auto flex flex-col flex-1 grow smart_input_show_on_open fixed visible rounded-box max-w-full mx-auto z-popover border-divider border-hair left-0 md:left-auto md:right-4 top-0 md:top-auto md:bottom-4 md:w-[32rem] md:right-4 md:top-auto h-full bg-base-100 overflow-clip md:overflow-visible overscroll-y-contain",
            "translate-y-100": e(@smart_input_opts, :open, nil) != true
          }
        >
          <div class="w-full rounded-box flex flex-col flex-1 h-full grow min-h-0">
            <div class="w-full rounded-box bg-base-200 flex flex-col flex-1 h-full grow min-h-0">
              <div class="relative z-50 rounded-box flex flex-col grow h-full min-h-0">
                <SmartInputLive
                  event_target={@myself}
                  custom_emojis={@custom_emojis}
                  boundaries_modal_id={:modal_composer}
                  showing_within={@showing_within}
                  reply_to_id={@reply_to_id}
                  context_id={@context_id}
                  smart_input_component={@smart_input_component}
                  open_boundaries={@open_boundaries}
                  to_boundaries={@to_boundaries}
                  to_circles={@to_circles}
                  exclude_circles={@exclude_circles}
                  verb_permissions={@verb_permissions}
                  mentions={@mentions}
                  context_group={@context_group}
                  smart_input_opts={@smart_input_opts}
                  activity={@activity}
                  object={@object}
                  uploads={@uploads}
                  uploaded_files={@uploaded_files}
                  selected_cover={@selected_cover}
                  trigger_submit={@trigger_submit}
                  reset_smart_input={@reset_smart_input}
                  activity_inception={@activity_inception}
                  preview_boundary_for_id={@preview_boundary_for_id}
                  preview_boundary_for_username={@preview_boundary_for_username}
                  preview_boundary_verbs={@preview_boundary_verbs}
                  boundary_preset={@boundary_preset}
                  quoted_object={@quoted_object}
                  quoted_url={@quoted_url}
                />
              </div>
            </div>
          </div>
        </div>
        <button
          :if={e(@smart_input_opts, :input_status, nil) == :draft}
          id="composer_draft_bar"
          type="button"
          phx-click={Bonfire.UI.Common.SmartInput.LiveHandler.open()}
          phx-target="#smart_input"
          class="composer-draft-bar fixed z-popover left-4 right-4 dock-safe-bottom md:bottom-0 flex min-h-12 items-center gap-3 rounded-box md:rounded-b-none px-4 text-left bg-primary text-primary-content shadow-lg focus-ring"
        >
          <#Icon iconify="ph:pencil-line-fill" class="size-5 shrink-0" />
          <span class="min-w-0 grow truncate text-sm font-medium">{l("Draft in progress. Tap to resume.")}</span>
          <#Icon iconify="ph:caret-up" class="size-4 shrink-0" />
        </button>
      {#else}
        <.portal id="composer_portal" class="relative z-max" target="body">
          <div
            id="smart_input_container"
            :hook
            data-hidden={e(@smart_input_opts, :open, nil) != true}
            data-draft={if e(@smart_input_opts, :input_status, nil) == :draft, do: "true"}
            data-focused={Settings.get([Bonfire.UI.Common.SmartInputContainerLive, :show_focused], false, @__context__)}
            class={
              "w-full md:h-auto flex flex-col flex-1 grow smart_input_show_on_open fixed visible rounded-box max-w-full mx-auto z-popover border-hair border-divider left-0 md:left-auto md:right-4 top-0 md:top-auto md:bottom-4 md:w-[32rem] md:right-4 md:top-auto h-full bg-base-100 overflow-clip md:overflow-visible overscroll-y-contain",
              "translate-y-100": e(@smart_input_opts, :open, nil) != true
            }
          >
            <div class="w-full rounded-box p-[0.05rem] flex flex-col flex-1 h-full grow min-h-0">
              <div class="w-full rounded-box bg-base-200 flex flex-col flex-1 h-full grow min-h-0">
                <div class="relative z-50 rounded-box flex flex-col grow h-full min-h-0">
                  <!-- <Bonfire.UI.Common.SmartInputHeaderModalLive smart_input_opts={@smart_input_opts} /> -->

                  <SmartInputLive
                    event_target={@myself}
                    custom_emojis={@custom_emojis}
                    boundaries_modal_id={:modal_composer}
                    showing_within={@showing_within}
                    reply_to_id={@reply_to_id}
                    context_id={@context_id}
                    smart_input_component={@smart_input_component}
                    open_boundaries={@open_boundaries}
                    to_boundaries={@to_boundaries}
                    to_circles={@to_circles}
                    exclude_circles={@exclude_circles}
                    verb_permissions={@verb_permissions}
                    mentions={@mentions}
                    context_group={@context_group}
                    smart_input_opts={@smart_input_opts}
                    activity={@activity}
                    object={@object}
                    uploads={@uploads}
                    uploaded_files={@uploaded_files}
                    selected_cover={@selected_cover}
                    trigger_submit={@trigger_submit}
                    reset_smart_input={@reset_smart_input}
                    activity_inception={@activity_inception}
                    preview_boundary_for_id={@preview_boundary_for_id}
                    preview_boundary_for_username={@preview_boundary_for_username}
                    preview_boundary_verbs={@preview_boundary_verbs}
                    boundary_preset={@boundary_preset}
                    quoted_object={@quoted_object}
                    quoted_url={@quoted_url}
                  />
                </div>
              </div>
            </div>
          </div>
          <button
            :if={e(@smart_input_opts, :input_status, nil) == :draft}
            id="composer_draft_bar"
            type="button"
            phx-click={Bonfire.UI.Common.SmartInput.LiveHandler.open()}
            phx-target="#smart_input"
            class="composer-draft-bar fixed z-popover left-4 right-4 dock-safe-bottom md:bottom-0 flex min-h-12 items-center gap-3 rounded-box md:rounded-b-none px-4 text-left bg-primary text-primary-content shadow-lg focus-ring"
          >
            <#Icon iconify="ph:pencil-line-fill" class="size-5 shrink-0" />
            <span class="min-w-0 grow truncate text-sm font-medium">{l("Draft in progress. Tap to resume.")}</span>
            <#Icon iconify="ph:caret-up" class="size-4 shrink-0" />
          </button>
        </.portal>
      {/if}
    {/if}
  </div>
</div>
{!-- a widget place, as the dashboard's main area; `?theme=` themes the widget, `?width=` caps its width --}
<div
  data-role="embed_widget"
  data-widget-place
  data-embed-links="_blank"
  data-theme={@embed_theme}
  class="w-full mx-auto"
  style={if @max_width, do: "max-width: #{@max_width}px", else: ""}
>
  {!-- a list, as `WidgetsLive` renders: `WidgetLive` is an `li` and the place rules target `> ul > li` --}
  <ul class="m-0 list-none p-0">
    <Bonfire.UI.Common.WidgetLive
      :if={@widget}
      widget={@widget}
      showing_within={:main}
      parent_id="embed_widget"
    />
  </ul>
</div>

{!--
  Poll card — composed from design-system primitives (<.card>, <.avatar>, <.badge>,
  <.button>) + theme spacing/type tokens. Radio is the DaisyUI input primitive.
--}
<.card padded={false} class="overflow-hidden" data-component="poll-card">
  <div class="px-4 pt-4 pb-4">
    {!-- header --}
    <header class="flex items-center gap-4">
      <.avatar src={@avatar_url} alt={@display_name} />
      <div class="min-w-0">
        <div class="text-base font-medium text-base-content leading-tight truncate">{@display_name}</div>
        <div class="text-base text-muted leading-tight truncate">{@username} <span class="text-primary">·</span> {@time_text}</div>
      </div>
    </header>

    {!-- badge row --}
    <div class="flex items-center gap-2 mt-4">
      <.badge variant="primary">UMFRAGE</.badge>
      <.badge variant="success" dot>{@status_label}</.badge>
      <span class="flex-1" />
      <span class="text-base font-medium text-base-content">{@vote_count}</span>
    </div>

    {!-- question (full-poll variant = text-xl) --}
    <div class="type-title text-base-content mt-4">{@question}</div>
  </div>

  {!-- options --}
  {#for opt <- @options}
    <label class="flex items-center gap-3 px-4 py-4 border-t-hair border-divider cursor-pointer">
      <input
        type="radio"
        name="poll-demo"
        checked={opt[:selected]}
        class="radio radio-primary radio-xs shrink-0"
      />
      <span class="text-base text-base-content tracking-tight">{opt[:label]}</span>
    </label>
  {/for}

  {!-- vote / results actions --}
  <div class="flex items-center gap-4 px-4 py-4 border-t-hair border-divider">
    <.button variant="primary">{@vote_label}</.button>
    <.button variant="muted">{@results_label}</.button>
  </div>

  {!-- action row (icon-to-icon gap is component-internal) --}
  <div class="flex items-center gap-7.5 px-4 pb-4">
    <#Icon iconify="ph:chat-circle" class="size-5.5 text-base-content" />
    <#Icon iconify="ph:rocket" class="size-5.5 text-base-content" />
    <#Icon iconify="ph:flame-fill" class="size-5.5 text-primary" />
    <#Icon iconify="ph:bookmark-simple" class="size-5.5 text-base-content" />
    <#Icon iconify="ph:dots-three-outline" class="size-5.5 text-base-content" />
  </div>
</.card>

{!--
  Who-to-follow card — composed from design-system primitives
  (<.card>, <.avatar>, <.button>) + theme tokens.
--}
<.card data-component="who-to-follow">
  <header class="flex items-center gap-4">
    <.avatar src={@avatar_url} alt={@display_name} />
    <div class="min-w-0">
      <div class="text-base font-medium text-base-content leading-tight truncate">{@display_name}</div>
      <div class="text-base text-muted leading-tight truncate">{@username}</div>
    </div>
  </header>

  <p class="mt-4 text-base text-base-content tracking-tight">{@bio}</p>{!-- header→bio = mt-4 (16px) (18) --}

  {#if @following}
    <.button variant="muted" full_width icon_left="ph:check-bold" class="mt-4">{@following_label}</.button>
  {#else}
    <.button variant="primary" full_width icon_left="ph:users-fill" class="mt-4">{@follow_label}</.button>
  {/if}
</.card>

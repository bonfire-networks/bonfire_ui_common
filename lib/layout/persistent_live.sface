<div
  id="persistent_live_view"
  data-role="persistent_live_view"
  phx-hook="KeyboardShortcuts"
  class="contents"
>
  <div id="persistent-header" class="px-4 lg:px-7.5 bg-base-200 z-sticky sticky top-0">
    <div class="pt-safe w-full">
      {#if current_user_id(@__context__)}
        <div class="flex flex-col w-full">
          {!-- mobile: one 56px row, 32px logo left + compact compose right.
               lg: stacked, logo (70² square, or 32px + instance name when compact) aligned to the
               page-header, then a full-width compose that shares the nav rows' highlight edges --}
          {#case Bonfire.UI.Common.LogoLive.compact_sidebar_logo?()}
            {#match compact_logo?}
              <div class="flex items-center justify-between gap-3 h-14 lg:h-auto lg:flex-col lg:items-stretch lg:justify-start lg:gap-0">
                <div class="flex items-center min-w-0 lg:pt-4">
                  <Bonfire.UI.Common.LogoLinkLive
                    href="/"
                    with_name={compact_logo?}
                    container_class="flex items-center gap-3 min-w-0 cursor-pointer"
                    image_class={if compact_logo?, do: "size-8 lg:size-9 rounded-[10px] object-cover ring-1 ring-inset ring-base-content/10", else: "size-8 lg:size-17.5"}
                    name_class="hidden lg:block min-w-0 truncate text-[17px] leading-6 font-bold tracking-tight text-base-content"
                  />
                </div>
                <div class={["shrink-0 lg:-mx-2 lg:pb-2", "lg:pt-5": compact_logo?, "lg:pt-8": !compact_logo?]}>
                  <Bonfire.UI.Common.SmartInputContainerLive
                    :if={!e(@smart_input_opts, :inline_only, nil) and
                      !e(@smart_input_opts, :disable, nil)}
                    id={:smart_input}
                    to_circles={@to_circles}
                    to_boundaries={@to_boundaries}
                    context_id={@context_id}
                    context_group={@context_group}
                    without_icon
                    composer_class="btn btn-primary focus-ring max-lg:btn-sm max-lg:text-sm max-lg:px-4 lg:w-full lg:h-9 lg:min-h-9"
                    smart_input_opts={@smart_input_opts}
                  />
                </div>
              </div>
          {/case}

          {#case to_string(Bonfire.Common.Settings.get([:ui, :sidebar, :section_divider], "none", :instance))}
            {#match "line"}
              <div
                class=""
                style="border-top: 1px solid color-mix(in oklch, var(--color-base-content) 10%, transparent)"
                aria-hidden="true"
              />
            {#match "custom"}
              {#case to_string(Bonfire.Common.Settings.get([:ui, :sidebar, :section_divider_image], "", :instance))}
                {#match src when src != ""}
                  <div class="flex justify-center" aria-hidden="true">
                    <img src={src} class="h-6 w-full object-contain" alt="">
                  </div>
                {#match _}
              {/case}
            {#match _}
          {/case}
        </div>
      {/if}
    </div>
  </div>

  <!-- {#if current_user_id(@__context__) && @__context__[:current_view] != Bonfire.Search.Web.SearchLive}
    <div role="search" class="w-full px-6 mb-3 block lg:hidden">
      <StatelessComponent
        module={maybe_component(Bonfire.Search.Web.FormLive, @__context__)}
        id="nav-search-persistent"
        search_limit={5}
      />
    </div>
  {/if} -->

  {#if current_user_id(@__context__)}
    {#if @__context__[:current_view] not in [
        # TODO: put in config
        Bonfire.UI.Me.SettingsLive,
        Bonfire.UI.Me.InstanceSettingsLive,
        Bonfire.UI.Boundaries.BoundariesLive
      ]}
      <div data-id="nav_sidebar_sticky_items" class="flex flex-col px-2 lg:px-0">
        <Bonfire.UI.Common.ExtensionMenuNavLive
          parent_id="nav_sticky"
          page={@page}
          selected_tab={@selected_tab}
          nav_items={Bonfire.UI.Common.NavModule.default_nav()}
        />
      </div>
    {/if}
  {/if}

  {!-- Notifications --}
  <.portal id="notification_portal" class="relative z-max" target="body">
    <Bonfire.UI.Common.NotificationLive id={:notification} root_flash={@flash} i={2} />
  </.portal>
  {!-- As with the composer, render directly in tests because portals require JavaScript. --}
  {#if Bonfire.Common.Config.env() == :test}
    <Bonfire.UI.Common.ReusableModalLive id="persistent_modal" />
  {#else}
    <.portal id="reusable_portal" class="relative z-max" target="body">
      <Bonfire.UI.Common.ReusableModalLive id="persistent_modal" />
    </.portal>
  {/if}
  <Bonfire.UI.Common.ReusableModalLive id="media_player_modal" />
  <Bonfire.UI.Common.KeyboardShortcutsHelpLive />
</div>

<% theme = Bonfire.UI.Common.ThemeHelper.theme_config(assigns) %> <!DOCTYPE html>
<html
  data-theme={theme.theme}
  data-theme-mode={theme.mode}
  data-theme-light={theme.light}
  data-theme-dark={theme.dark}
  data-ui-preset={
    Bonfire.UI.Common.ThemeHelper.preview_ui_preset(@conn) ||
      Bonfire.UI.Common.ThemeHelper.ui_preset(assigns)
  }
  data-ui-preset-preview={Bonfire.UI.Common.ThemeHelper.preview_ui_preset(@conn) && "true"}
  data-icon-weight={Bonfire.UI.Common.ThemeHelper.icon_weight(assigns)}
  data-icon-weight-hrefs={@conn.assigns[:current_user_id] &&
    Bonfire.UI.Common.ThemeHelper.icon_weight_css_hrefs_json()}
  data-user={@conn.assigns[:current_user_id]}
  id="root"
  class="bg-base-200"
  data-open="false"
  style={Bonfire.UI.Common.ThemeHelper.custom_theme_style(assigns)}
  lang={Bonfire.Common.Localise.html_lang()}
>
  <head>
    <meta charset="utf-8" />
    <%!-- Resolve the `:system` theme from the device's prefers-color-scheme before paint (no flash),
          and keep tracking live OS changes. Fixed themes are left as server-rendered. --%>
    <script>
      (function() {
        var el = document.documentElement;
        if (el.getAttribute("data-theme-mode") !== "system") return;
        var mq = window.matchMedia("(prefers-color-scheme: dark)");
        function apply() {
          el.setAttribute("data-theme", mq.matches ? el.getAttribute("data-theme-dark") : el.getAttribute("data-theme-light"));
        }
        apply();
        mq.addEventListener("change", apply);
        window.__bonfireSystemTheme = { mq: mq, apply: apply };
      })();
      // Track the custom-theme vars applied inline on <html> at SSR (by prefix) so the
      // set_custom_theme listener can clear them all when the palette changes/clears.
      window.__bonfireCustomVars = Array.prototype.filter.call(
        document.documentElement.style,
        function(n) { return /^--(color|radius|size|border|depth|noise)/.test(n); }
      );
      // This layout is rendered without the user (`ThemeHelper.push_current_icon_weight/1`), so on signed-in pages their theme, palette, preset and icon weight only arrive as pushed events once the socket joins. Remembered per user, they are applied here before first paint; the handlers are shared with the listeners at the end of the body.
      (function() {
        var el = document.documentElement;
        var uid = el.getAttribute("data-user");
        var key = uid && "bonfire:ui:" + uid;
        var apply = {
          set_theme: function(d) {
            // Tear down any previously attached system listener before switching modes
            if (window.__bonfireSystemTheme) {
              window.__bonfireSystemTheme.mq.removeEventListener("change", window.__bonfireSystemTheme.apply);
              window.__bonfireSystemTheme = null;
            }
            if (d.theme === "system") {
              if (d.light) el.setAttribute("data-theme-light", d.light);
              if (d.dark) el.setAttribute("data-theme-dark", d.dark);
              el.setAttribute("data-theme-mode", "system");
              var mq = window.matchMedia("(prefers-color-scheme: dark)");
              var applySystem = function() {
                el.setAttribute("data-theme", mq.matches ? el.getAttribute("data-theme-dark") : el.getAttribute("data-theme-light"));
              };
              applySystem();
              mq.addEventListener("change", applySystem);
              window.__bonfireSystemTheme = { mq: mq, apply: applySystem };
            } else {
              el.setAttribute("data-theme-mode", "fixed");
              el.setAttribute("data-theme", d.theme);
            }
          },
          set_custom_theme: function(d) {
            // apply the custom palette's CSS vars on <html>, overriding the base [data-theme] palette
            (window.__bonfireCustomVars || []).forEach(function(name) { el.style.removeProperty(name); });
            var applied = [];
            var style = d && d.style;
            if (style) {
              style.split(";").forEach(function(decl) {
                var i = decl.indexOf(":");
                if (i === -1) return;
                var name = decl.slice(0, i).trim();
                if (!name) return;
                el.style.setProperty(name, decl.slice(i + 1).trim());
                applied.push(name);
              });
            }
            window.__bonfireCustomVars = applied;
            if (window.__bonfireSyncThemeColor) window.__bonfireSyncThemeColor();
          },
          set_icon_weight: function(d) {
            var link = document.querySelector("link[data-icon-weight-css]");
            if (d.weight) {
              if (!link) {
                link = document.createElement("link");
                link.rel = "stylesheet";
                link.setAttribute("data-icon-weight-css", "");
                link.setAttribute("phx-track-static", "");
                document.head.appendChild(link);
              }
              if (link.getAttribute("href") !== d.href) link.setAttribute("href", d.href);
              el.setAttribute("data-icon-weight", d.weight);
            } else {
              el.removeAttribute("data-icon-weight");
              if (link) link.remove();
            }
          },
          set_ui_preset: function(d) {
            if (el.hasAttribute("data-ui-preset-preview")) return;
            if (d.preset) el.setAttribute("data-ui-preset", d.preset);
          }
        };
        // anything but an object (storage blocked, or an entry that isn't ours) reads as nothing remembered, and is overwritten by the next save
        var read = function() {
          try {
            var stored = JSON.parse(localStorage.getItem(key) || "{}");
            return stored && typeof stored === "object" ? stored : {};
          } catch (_) {
            return {};
          }
        };
        window.__bonfireUi = {
          apply: apply,
          save: function(name, detail) {
            if (!key) return;
            try {
              var saved = read();
              saved[name] = detail;
              localStorage.setItem(key, JSON.stringify(saved));
            } catch (_) {}
          }
        };
        if (!key) return;
        var saved = read();
        var hrefs = {};
        try { hrefs = JSON.parse(el.getAttribute("data-icon-weight-hrefs") || "{}") || {}; } catch (_) {}
        ["set_theme", "set_custom_theme", "set_ui_preset"].forEach(function(name) {
          var d = saved[name];
          if (!d || typeof d !== "object") return;
          if (name === "set_theme" && typeof d.theme !== "string") return;
          apply[name](d);
        });
        // signed-in pages get no weight stylesheet in the HTML (the browser would fetch it before this runs): link the remembered weight, else the server's; the href comes from this page, as a remembered one goes stale with a deploy
        var remembered = saved.set_icon_weight && saved.set_icon_weight.weight;
        var weight = hrefs[remembered] ? remembered : el.getAttribute("data-icon-weight");
        if (weight && hrefs[weight]) apply.set_icon_weight({ weight: weight, href: hrefs[weight] });
      })();
    </script>
    <%= Application.get_env(:live_debugger, :live_debugger_tags) %>

    <%= if !@conn.assigns[:current_user_id] do %>
      <SEO.juice
        page_title={assigns[:page_title]}
        canonical_url={assigns[:canonical_url]}
        conn={@conn}
        config={Bonfire.UI.Common.SEO.config()}
      />
    <% end %>

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover, interactive-widget=resizes-visual"
    />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />

    {raw(Bonfire.Common.Config.endpoint_module().include_assets(@conn, :top))}
    <%!-- The status bar takes the theme's base-100, set here (after the stylesheets and the theme-color meta) so a light theme never loads under a dark bar. --%>
    <script>
      (function() {
        var el = document.documentElement;
        var meta = document.querySelector('meta[name="theme-color"]');
        if (!meta || !window.CSS || !CSS.supports) return;
        var ctx = document.createElement("canvas").getContext("2d", { willReadFrequently: true });
        if (!ctx) return;
        function sync() {
          var color = getComputedStyle(el).getPropertyValue("--color-base-100").trim();
          if (!color || !CSS.supports("color", color)) return;
          ctx.clearRect(0, 0, 1, 1);
          ctx.fillStyle = "#010203"; // marker: a colour the canvas can't parse leaves fillStyle unchanged
          ctx.fillStyle = color; // themes are oklch, which not every browser takes in theme-color: read it back as rgb
          if (ctx.fillStyle === "#010203") return; // keep the server's fallback rather than paint black
          ctx.fillRect(0, 0, 1, 1);
          var p = ctx.getImageData(0, 0, 1, 1).data;
          meta.setAttribute("content", "rgb(" + p[0] + "," + p[1] + "," + p[2] + ")");
        }
        sync();
        new MutationObserver(sync).observe(el, { attributes: true, attributeFilter: ["data-theme"] }); // not `style`: the composer and resize handlers write CSS vars there many times a second
        window.__bonfireSyncThemeColor = sync;
      })();
    </script>

    <%= if assigns[:no_index] do %>
      <meta name="robots" content="noindex" />
    <% end %>

    <%!-- session-cookie-carriers only: generating a CSRF token makes Plug.CSRFProtection WRITE it to the session (→ Set-Cookie), and guest LiveViews are dead renders that never connect, so the token would only mint a useless cookie, instead we want guests stay cookieless (GDPR/caching/the overload shed plug's presence check). Guest forms (login/signup) still generate their own hidden token + session write where actually needed. --%>
    <%= if Bonfire.UI.Common.EndpointTemplate.session_cookie?(@conn) do %>
      {csrf_meta_tag()}
    <% end %>
  </head>

  <body class="bg-base-200" id="layout-root">
    {@inner_content}

    {raw(Bonfire.Common.Config.endpoint_module().include_assets(@conn, :bottom))}

    <script>
      Object.keys(window.__bonfireUi.apply).forEach(function(name) {
        window.addEventListener("phx:" + name, function(e) {
          window.__bonfireUi.apply[name](e.detail);
          if (e.detail && e.detail.remember) window.__bonfireUi.save(name, e.detail);
        });
      });
      window.addEventListener("phx:set_font", function(e) {
        var link = document.querySelector("link[data-font]");
        if (link) link.setAttribute("href", e.detail.href);
        document.documentElement.style.setProperty("--font-sans", '"' + e.detail.font_name + '", ui-sans-serif, system-ui, sans-serif');
      });
    </script>
  </body>
</html>

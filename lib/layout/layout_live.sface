<div
  data-id="bonfire_live"
  class="antialiased bg-base-100 lg:bg-base-300 min-h-screen min-h-screen-safe pb-safe"
>
  <a
    href="#main-content"
    class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-toast focus:px-4 focus:py-2 focus:bg-primary focus:text-primary-content focus:rounded-box focus:font-medium"
  >
    {l("Skip to main content")}
  </a>

  <div class={
    "drawer lg:drawer-open mx-auto w-full lg:bg-base-200 border-divider lg:border-l-hair xl:border-r-hair",
    "lg:max-w-(--shell-width)": !@full_width
  }>
    <input id="sidebar-drawer" type="checkbox" class="drawer-toggle" phx-update="ignore">
    <div class="drawer-content lg:border-l-hair lg:border-divider dock-offset">
      <div
        data-id="layout"
        data-two-columns={@without_secondary_widgets == true && @without_sidebar != true}
        data-single-column={@without_sidebar == true}
        class={[
          "drawer drawer-end": @without_secondary_widgets != true,
          "xl:drawer-open": @without_secondary_widgets != true
        ]}
      >
        <input
          :if={@without_secondary_widgets != true}
          id="widgets-drawer"
          type="checkbox"
          class="drawer-toggle"
          phx-update="ignore"
        />
        <div class="drawer-content xl:border-r-(length:--content-divider-width) xl:border-divider">
          <div
            data-id="main_section"
            data-single-column={@without_sidebar == true}
            class="relative w-full gap-2 xl:gap-0"
          >
            <Bonfire.UI.Common.GuestHeaderLive
              selected_tab={@selected_tab}
              page={@page}
              :if={is_nil(@current_user_id) and @no_header != true and @without_sidebar == true}
            />
            <div class="h-full mt-0">
              <div class="relative invisible_frame">
                <div class="md:pb-0 md:overflow-y-visible">
                  <Bonfire.UI.Common.PreviewContentLive show={@hide_main} id="preview_content" />

                  <main
                    id="main-content"
                    class={
                      "flex flex-col",
                      hidden: @hide_main,
                      "border-none": @without_sidebar == true
                    }
                  >
                    <div
                      :if={!@no_header}
                      data-role="page_header_bar"
                      class="sticky top-0 pt-safe z-[9999999] bg-base-100 mb-[1px] lg:bg-base-200/70 backdrop-blur-sm flex items-center place-content-center lg:min-h-page-header"
                    >
                      <div class="flex pt-2 lg:pt-0 pb-2 lg:pb-0 place-content-center flex-1 w-full transition-colors duration-150 ease-in-out">
                        <StatelessComponent
                          module={maybe_component(Bonfire.UI.Common.PageHeaderLive, @__context__)}
                          page={@page}
                          page_title={@page_title}
                          page_header_icon={@page_header_icon}
                          page_title_context={@page_title_context}
                          show_widgets_toggle={@without_secondary_widgets != true}
                          back={@back}
                          extra={@extra}
                        >
                          <:right_action>
                            {#for {component, component_assigns} <- e(@page_header_aside, [])}
                              {#if (resolved = maybe_component(component, @__context__)) && Code.ensure_loaded?(resolved) &&
                                  function_exported?(resolved, :__live__, 0)}
                                <StatefulComponent module={resolved} {...component_assigns || []} />
                              {#else}
                                <StatelessComponent module={resolved} {...component_assigns || []} />
                              {/if}
                            {/for}
                          </:right_action>
                        </StatelessComponent>
                      </div>
                    </div>
                    {@inner_content}
                  </main>
                </div>
              </div>
            </div>
          </div>
        </div>
        <div
          :if={@without_secondary_widgets != true}
          class="drawer-side z-[9999999] xl:z-0 xl:!sticky xl:!top-0 xl:!h-screen"
        >
          <label for="widgets-drawer" aria-label={l("Close widgets sidebar")} class="drawer-overlay" />
          <div
            data-id="right_nav_and_widgets"
            role="complementary"
            aria-label={l("Widgets sidebar")}
            class="w-rail-end bg-rail lg:bg-transparent xl:border-l-(length:--rail-divider-width) xl:border-divider min-h-0 flex flex-col h-full overflow-y-auto pt-safe lg:pt-0 xl:ml-(--rail-offset)"
          >
            <div
              :if={not is_nil(@current_user_id) and socket_connected?(@__context__)}
              class="shrink-0 p-4 flex items-center"
            >
              <div role="search" class="w-full">
                <StatelessComponent
                  module={maybe_component(Bonfire.Search.Web.FormLive, @__context__)}
                  id="sidebar-search"
                  search_limit={5}
                />
              </div>
            </div>
            <div
              data-id="secondary_sidebar_widgets"
              class="sidebar-widgets overflow-x-visible overflow-y-auto flex-1 min-h-0 flex flex-col gap-(--widget-gap)"
            >
              <Bonfire.UI.Common.SidebarWidgetsLive
                widgets={if @preview_sidebar_widgets != [], do: @preview_sidebar_widgets, else: @sidebar_widgets}
                key={:secondary}
                page={@page}
                selected_tab={@selected_tab}
                parent_id="layout_right"
              />

              <div>
                <div class="flex flex-col gap-2 pb-2">
                  <div :if={!@current_user_id} class="flex flex-col gap-2 p-card">
                    <Bonfire.UI.Common.GuestAuthActionsLive login_class="btn btn-ds-outline" />
                  </div>
                  <Bonfire.UI.Common.ImpressumLive />
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class={
      "drawer-side z-modal lg:z-0 lg:!sticky lg:!top-0 lg:!h-screen ",
      hidden: @without_sidebar == true
    }>
      <label for="sidebar-drawer" aria-label={l("Close sidebar")} class="drawer-overlay" />
      <aside
        id="nav_sidebar"
        data-id="nav_sidebar"
        data-sidebar-minimal={@without_sidebar == :minimal}
        class={
          "w-80 px-4 px-safe lg:px-0 lg:mr-(--rail-offset) lg:w-rail lg:border-r-(length:--rail-divider-width) lg:border-divider bg-rail self-stretch flex flex-col overflow-y-auto min-h-[calc(var(--inner-window-height))] lg:min-h-0 lg:h-screen lg:pb-0",
          "pb-safe": !(@current_user_id && @without_sidebar != true)
        }
      >
        <div class="flex flex-col flex-1 min-h-full lg:flex-none">
          {!-- Skeleton mirroring PersistentLive's shape. Always rendered alongside the sticky LV;
               hidden by CSS (see app.css `[data-role="persistent_skeleton"]:has(...)`) once the
               sticky child fills its container. Prevents the vertical reflow that happens while
               the sticky child's separate channel join is in flight. --}
          {#if @current_user_id && @without_sidebar != true}
            <div data-role="persistent_skeleton" class="block w-full lg:shrink-0" aria-hidden="true">
              {!-- mirrors PersistentLive's #persistent-header exactly (mobile: 56px row, 32px logo +
                   ghost icon compose; lg: 70² logo, pt-4 header row, then a full-width
                   compose) so there's no reflow when the sticky LV fills in --}
              <div class="px-4 lg:px-7.5 bg-base-200 z-sticky sticky top-0">
                <div class="pt-safe w-full">
                  <div class="flex items-center justify-between gap-3 h-14 lg:h-auto lg:flex-col lg:items-stretch lg:justify-start lg:gap-0">
                    <div class="flex items-center min-w-0 lg:pt-4">
                      <Bonfire.UI.Common.LogoLinkLive
                        href="/"
                        container_class="flex items-center gap-3 min-w-0 cursor-pointer"
                        image_class="size-8 lg:size-17.5"
                        with_name
                        name_class="lg:hidden min-w-0 truncate text-base font-bold text-base-content"
                      />
                    </div>
                    <div class="shrink-0 lg:-mx-2 lg:pb-2 lg:pt-8">
                      <div class="skeleton rounded-full size-8 lg:rounded-field lg:h-9 lg:w-full" />
                    </div>
                  </div>
                </div>
              </div>

              {#if @__context__[:current_view] not in [
                  Bonfire.UI.Me.SettingsLive,
                  Bonfire.UI.Me.InstanceSettingsLive,
                  Bonfire.UI.Boundaries.BoundariesLive
                ]}
                <div class="flex flex-col px-2 lg:px-0">
                  <div class="gap-1 lg:gap-0">
                    <ul class="menu p-0 w-full gap-0 px-0 lg:px-5.5 mt-2">
                      <li class="m-0 p-0 justify-end !block">
                        <div class="nav-row">
                          <div class="skeleton size-5 rounded shrink-0" />
                          <div class="skeleton h-4 w-24 rounded" />
                        </div>
                      </li>
                      <li class="m-0 p-0 justify-end !block">
                        <div class="nav-row">
                          <div class="skeleton size-5 rounded shrink-0" />
                          <div class="skeleton h-4 w-20 rounded" />
                        </div>
                      </li>
                      <li class="m-0 p-0 justify-end !block">
                        <div class="nav-row">
                          <div class="skeleton size-5 rounded shrink-0" />
                          <div class="skeleton h-4 w-16 rounded" />
                        </div>
                      </li>
                    </ul>
                  </div>
                </div>
              {/if}
            </div>
          {/if}

          {#if @current_user_id && @without_sidebar != true && socket_connected?(@__context__)}
            <Bonfire.UI.Common.PersistentLive
              id={:persistent}
              sticky
              container={{:div, class: "block w-full lg:contents"}}
              session={%{
                "page" => @page,
                "selected_tab" => @selected_tab,
                "context" => %{
                  sticky: true,
                  current_url: current_url(@__context__),
                  initial_parent_pid: self(),
                  csrf_token: @csrf_token,
                  # csrf_socket_token: @__context__[:csrf_socket_token],
                  current_user_id: @current_user_id,
                  current_account_id: @current_account_id,
                  current_user_avatar_url: Media.avatar_url(current_user(@__context__))
                }
              }}
            />
          {#else}
            <div
              :if={!@current_user_id}
              class="px-5 px-10 pt-4 bg-base-200 lg:bg-base-200 z-sticky lg:shrink-0 flex items-center lg:min-h-12 justify-between"
            >
              <div class="flex pt-safe w-full">
                <div class="lex items-center justify-between">
                  <Bonfire.UI.Common.LogoLinkLive
                    image_class="size-16 bg-center bg-no-repeat bg-contain"
                    href="/"
                  />
                </div>
              </div>
            </div>
          {/if}

          <div id="nav_sidebar_scroll" class="lg:flex-1">
            <Bonfire.UI.Common.NavSidebarLive
              page={@page}
              selected_tab={@selected_tab}
              nav_items={@nav_items}
              sidebar_widgets={@sidebar_widgets}
            />
          </div>

          <Bonfire.UI.Common.UserMenuLive :if={@current_user_id && @without_sidebar != true} />
        </div>
      </aside>
    </div>
  </div>

  <div :if={!@hide_mobile_dock} class="dock z-fixed lg:hidden text-base-content">
    {#if current_user(@__context__)}
      <label for="sidebar-drawer" aria-label={l("Open navigation sidebar")} class="">
        <div class="relative">
          {#if @__context__[:current_view] in [Bonfire.UI.Me.SettingsLive, Bonfire.UI.Me.InstanceSettingsLive]}
            <div class="size-9 rounded-full ring-[0.7px] ring-primary flex items-center justify-center">
              <#Icon iconify="ph:gear-fill" class="size-5 text-primary" />
            </div>
          {#else}
            <Bonfire.UI.Common.AvatarLive
              ring
              bg_class="rounded-full"
              title={e(current_user(@__context__), :profile, :name, "Anon")}
              class="inline-block object-cover cursor-pointer rounded-full size-9"
              src={Media.avatar_url(current_user(@__context__))}
              user_id={current_user_id(@__context__)}
              is_remote={false}
            />
          {/if}
          <span
            aria-hidden="true"
            class="rounded-full bg-base-100 absolute -right-1 -bottom-1 leading-none"
          >
            <#Icon iconify="ph:list-bold" class="size-4 text-primary" />
          </span>
        </div>
      </label>

      <LinkLive
        to={~p"/search"}
        class={
          "dock-active":
            @selected_tab in [:search, "Bonfire.Data.Identity.User", "Bonfire.Data.Social.Post"]
        }
      >
        <#Icon iconify="ph:magnifying-glass-fill" class="size-6" aria-hidden="true" />
        <span class="sr-only">{l("Search")}</span>
      </LinkLive>

      <button
        type="button"
        phx-click={Bonfire.UI.Common.SmartInput.LiveHandler.open(%JS{}, %{})}
        phx-target="#smart_input"
        aria-label={l("Compose")}
      >
        <#Icon iconify="ph:note-pencil-fill" class="size-6" aria-hidden="true" />
        <span class="sr-only">{l("Compose")}</span>
      </button>

      <LinkLive
        to={~p"/notifications"}
        class={"dock-active": @page in [:notifications, "notifications"]}
      >
        <span class="relative inline-flex">
          <#Icon iconify="ph:bell-fill" class="size-6" aria-hidden="true" />
          <span class="absolute -top-2 -right-2">
            <StatefulComponent
              id="dock-notifications-badge"
              module={maybe_component(Bonfire.UI.Common.BadgeCounterLive, @__context__)}
              feed_id={e(current_user(@__context__), :character, :notifications_id, nil)}
            />
          </span>
        </span>
        <span class="sr-only">{l("Notifications")}</span>
      </LinkLive>

      {#if extension_enabled?(:bonfire_ui_groups, @__context__)}
        <LinkLive to="/groups" class={"dock-active": @page in [:groups, "groups"]}>
          <#Icon iconify="ph:users-three-fill" class="size-6" aria-hidden="true" />
          <span class="sr-only">{l("Groups")}</span>
        </LinkLive>
      {#else}
        <LinkLive to={~p"/messages"} class={"dock-active": @selected_tab in [:messages, "messages"]}>
          <span class="relative inline-flex">
            <#Icon iconify="ph:tray-fill" class="size-6" aria-hidden="true" />
            <span class="absolute -top-2 -right-2">
              <StatefulComponent
                id="dock-messages-badge"
                module={maybe_component(Bonfire.UI.Common.BadgeCounterLive, @__context__)}
                feed_id={e(current_user(@__context__), :character, :inbox_id, nil)}
              />
            </span>
          </span>
          <span class="sr-only">{l("Messages")}</span>
        </LinkLive>
      {/if}
    {#else}
      <div class="flex flex-row items-center justify-between basis-full max-w-none gap-3 mb-0">
        <Bonfire.UI.Common.LogoLinkLive
          href="/"
          container_class="min-w-0 flex flex-1 flex-row items-center cursor-pointer"
          image_class="size-10 shrink-0 object-contain"
          link_opts={[id: "dock-instance-home"]}
        />

        <Bonfire.UI.Common.GuestAuthActionsLive
          login_id="dock-login-action"
          signup_id="dock-signup-action"
          login_class="btn btn-soft shrink-0 px-4 whitespace-nowrap"
          signup_class="btn btn-primary shrink-0 px-4 whitespace-nowrap"
        />
      </div>
    {/if}
  </div>
</div>

<Bonfire.UI.Common.ReusableModalLive id="modal" />

{!-- one profile hover card for the page, logged-in viewers only (guests get cached pages where its load can't run) --}
<StatefulComponent
  :if={@current_user_id}
  module={maybe_component(Bonfire.UI.Me.ProfileHoverCardLive, @__context__)}
  id="profile_hover_card"
/>

<div class="relative z-max">
  <Bonfire.UI.Common.NotificationLive id={:notification} root_flash={@flash} />
  <StatefulComponent
    module={maybe_component(Bonfire.Notify.AppBannerLive, @__context__)}
    id="app_banner"
  />
</div>

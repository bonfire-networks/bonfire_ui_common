<div class="flex items-center justify-center min-h-screen bg-base-100">
  <div class="flex flex-col items-center gap-4">
    <%= case maybe_cute_gif() do %>
      <% gif when is_binary(gif) -> %>
        <div class="flex flex-row items-center justify-center my-12">
          <img src={gif} />
        </div>
      <% _ -> %>
        <span class="loading loading-ring loading-xl text-primary" />
    <% end %>

    <% msg = maybe_loading_msg() || l("Loading...") %>
    <div class="m-6" role="status">
      <span class="font-mono text-base">
        {msg}
      </span>
    </div>

    <%!-- Skeleton (@inner_content) intentionally hidden while the flame + loading text are shown --%>
    <div class="hidden">
      {@inner_content}
    </div>
  </div>
</div>
